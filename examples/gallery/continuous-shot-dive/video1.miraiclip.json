      "template": "<div class=\"stage\" data-libs=\"stage\" data-duration=\"14\" data-stage-version=\"2\" style=\"width:1920px;height:1080px\"><style>\n*{box-sizing:border-box;margin:0}\n.stage{background:#f2ede4;color:#1c1b19;font-family:Inter,\"DejaVu Sans\",system-ui,sans-serif;overflow:hidden}\n.world{position:absolute;left:0;top:0;width:1920px;height:1080px}\n.abs{position:absolute}\n#bar{left:320px;top:484px;width:1280px;height:112px;border-radius:56px;background:#fff;border:3px solid #1c1b19;z-index:4}\n#prompt{left:370px;top:510px;font-size:48px;font-weight:600;white-space:nowrap;z-index:6}\n#prompt .caret{display:inline-block;width:5px;height:54px;background:#e4572e;margin-left:6px;vertical-align:-9px}\n#send{left:1460px;top:502px;width:76px;height:76px;border-radius:50%;background:#e4572e;z-index:6;display:grid;place-items:center;color:#fff;font-size:42px;font-weight:800}\n#win{left:260px;top:130px;width:1400px;height:760px;border-radius:30px;background:#fff;border:3px solid #1c1b19;z-index:3;opacity:0}\n.nav{left:0;top:0;width:100%;height:84px;border-bottom:3px solid #1c1b19;display:flex;align-items:center;padding:0 40px;font-size:34px;font-weight:800}\n.hero{left:70px;top:130px;font-size:92px;font-weight:800;line-height:1.02;letter-spacing:-.02em}\n.tile{top:470px;width:380px;height:210px;border-radius:24px;border:3px solid #1c1b19;display:grid;place-items:center;font-size:40px;font-weight:700;z-index:5}\n#t1{left:70px;background:#ffd9c9}#t2{left:510px;background:#d9e7ff}#t3{left:950px;background:#e3f5d0}\n#pub{left:730px;top:930px;width:460px;height:110px;border-radius:55px;background:#e4572e;color:#fff;display:grid;place-items:center;font-size:48px;font-weight:800;z-index:6;opacity:0}\n#veil{left:0;top:0;width:1920px;height:1080px;background:#f2ede4;z-index:7;opacity:0}\n#live{left:510px;top:315px;width:900px;height:450px;border-radius:40px;background:#1c1b19;color:#f2ede4;display:grid;place-items:center;text-align:center;z-index:9;opacity:0}\n#live h2