{
  "name": "miraiclip",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "changeset": "changeset",
    "release": "pnpm -r build && changeset publish",
    "stress": "pnpm --filter miraiclip-playground stress && pnpm --filter @miraiclip/server-export stress",
    "corpus": "pnpm --filter @miraiclip/server-export corpus"
  },
  "packageManager": "pnpm@10.28.0",
  "devDependencies": {
    "@changesets/cli": "^3.0.2"
  }
}
