{
  "name": "callout-step-badge",
  "title": "Callout — step badge",
  "description": "A numbered circle that pops in with a pulse ring. Mark the order of steps on screen.",
  "category": "callout",
  "tags": [
    "tutorial",
    "step",
    "number"
  ],
  "version": "1.0.0",
  "aspects": [
    "any"
  ],
  "fields": [
    {
      "key": "n",
      "label": "Number",
      "type": "text",
      "default": "1"
    },
    {
      "key": "color",
      "label": "Colour",
      "type": "color",
      "default": "#22d3ee"
    }
  ],
  "content": {
    "kind": "html",
    "template": "<div style=\"width:200px;height:200px;display:flex;align-items:center;justify-content:center;font-family:Inter,system-ui,'Segoe UI',Roboto,sans-serif\"><style>@keyframes mc-rise{from{transform:translateY(40%);opacity:0}}\n@keyframes mc-fade{from{opacity:0}}\n@keyframes mc-out{to{opacity:0}}\n@keyframes mc-pop{0%{transform:scale(.6);opacity:0}70%{transform:scale(1.06);opacity:1}100%{transform:scale(1)}}\n@keyframes mc-wipe{from{clip-path:inset(0 100% 0 0)}to{clip-path:inset(0 0 0 0)}}\n@keyframes mc-growx{from{transform:scaleX(0)}}\n@keyframes ring{0%{transform:scale(.8);opacity:.8}100%{transform:scale(1.6);opacity:0}}</style>\n<div style=\"animation:mc-out 0.3s ease-in both;--d:calc(var(--T) - 0.3s)\"><div style=\"position:relative;width:200px;height:200px;display:flex;align-items:center;justify-content:center\"><div style=\"position:absolute;left:45px;top:45px;width:110px;height:110px;box-sizing:border-box;border-radius:50%;border:6px solid {{color}};animation:ring 1.2s ease-out 2 both;--d:.3s\"></div>\n<div style=\"width:110px;height:110px;border-radius:50%;background:{{color}};color:#04121a;font-weight:900;font-size:58px;display:flex;align-items:center;justify-content:center;box-shadow:0 10px 30px #0007;--d:0s;animation:mc-pop .45s cubic-bezier(.2,.8,.2,1) both\">{{n}}</div></div></div></div>",
    "widthPx": 200,
    "heightPx": 200,
    "animated": true,
    "durationUs": 3000000,
    "transform": {
      "x": 0.5,
      "y": 0.5
    }
  }
}
