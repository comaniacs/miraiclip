{
  "name": "@miraiclip/core",
  "version": "0.1.0",
  "description": "Headless, command-driven engine for building video editors — state, commands, history, patches, events.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/comaniacs/miraiclip.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "immer": "^10.1.3",
    "nanoid": "^5.1.6",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
