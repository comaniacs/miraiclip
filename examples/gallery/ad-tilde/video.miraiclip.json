 film/60-camera.js\n// ---- one camera take: [t, yaw, elev, dist, tx, ty, ox, oy] through the kit's monotone curves\nvar CAM = filmCamera([\n  [0.0, 0, 4, 520, 0, 120, 0, 0], //         macro on the rising bubble\n  [3.6, 6, 10, 560, 0, -440, 0, 0], //       at the lid as it pops\n  [5.4, 16, 26, 1150, 0, -380, 120, 0], //   pulling back and down the can\n  [8.6, -10, 10, 1500, 0, -230, 330, 20], // 3/4, the can right, the name left\n  [10.4, 0, 5, 1700, -320, -220, 0, 20], // frontal and wide: the label peels into a card\n  [14.4, 6, 6, 1760, -320, -220, 0, 20],\n  [16.4, 40, -4, 1250, 0, -250, 0, 0], //   low orbit through the citrus\n  [20.4, 118, 4, 1220, 0, -250, 0, 0],\n  [23.0, 172, 22, 1650, 0, -260, 0, 0], //  rising for the climax\n  [25.8, 196, 10, 1500, 0, -230, 340, 20], // hero: the can right, the lockup left\n  [28.6, 200, 9, 1480, 0, -230, 340, 20],\n  [30.0, 200, 9, 1480, 0, -230, 340, 20],\n], [[0, -220, 0], [150, -440, 0], [-150, 0, 0], [0, -220, 300]]);\nvar camAt = CAM.camAt;\n// the can turns to show itself in the introduction, and otherwise keeps its label toward the camera\nfunction spinAt(t, c) { return -c.yaw + 35 * Math.sin(Math.PI * c01((t - 4.4) / 4.6)) + 40 * Math.sin(Math.PI * c01((t - 15.6) / 8.6)); }\n\n// ==== film/70-overlay.js\n// ---- motion graphics: headlines, the ingredient card's counters, the tilde wave round the can, and the lockup\nvar wave = $(\"kline\");\nfunction poseWave(t, c) { // a coral tilde wave circling the can at its waist, drawn once round, then letting go\n  var u = smoother((t - T.wave[0]) / (T.wave[1] - T.wave[0])), out = smr(t, T.wave[1] - 0.2, T.wave[1] + 0.6);\n  if (u <= 0 || out >= 1) { wave.style.opacity = 0; return; }\n  var pts = [];\n  for (var k = 0; k <= 72; k++) { var a = k / 72 * 2 * Math.PI + 0.5; pts.push([Math.cos(a) * 250, -230 + 34 * Math.sin(3 * a + 2 * t), Math.sin(a) * 250]); }\n  drawLine(wave, pts, c, u, 1 - out);\n}\nfunction poseType(t) {\n  lineIO(\"i1\", T.intro, t); lineIO(\"i2\", [T.word[0], T.word[1]], t);\n  lineIO(\"f0\", T.facts, t);\n  [\"f1\", \"f2\", \"f3\", \"f4\"].forEach(function (id, k) { fadeIO(id, T.facts[0] + 0.45 + 0.35 * k, T.facts[1], t, 18); });\n  $(\"f1n\").textContent = Math.round(3 * smoother((t - T.facts[0] - 0.45) / 0.7));\n  lineIO(\"e1\", T.exp, t);\n  var u = smoother((t - T.title) / 0.9);\n  $(\"lock\").style.opacity = u.toFixed(3); $(\"lock\").style.letterSpacing = mix(0.5, 0.16, u).toFixed(3) + \"em\";\n  $(\"lockwave\").style.strokeDashoffset = (1 - smoother((t - T.title - 0.2) / 1.0)).toFixed(3);\n  lineIO(\"tag\", [T.tag, 99], t);\n  fadeIO(\"cta\", T.cta, 99, t, 10);\n}\n\n// ==== film/90-main.js\n// ---- the frame\nfunction paint(t) {\n  var c = camAt(t);\n  $(\"view\").style.transform = \"translate(\" + f2(c.ox) + \"px,\" + f2(c.oy) + \"px)\";\n  world.style.transform = $(\"ground\").style.transform = camTransform(c);\n  poseCan(t, c, spinAt(t, c));\n  poseBubbles(t, c); poseCitrus(t); poseWave(t, c);\n  $(\"floorglow\").style.opacity = keyAmt(t).toFixed(3);\n}\ntl.frame(paint, { motion: CAM.motionOf });\ntl.frame(poseType, { hold: true });\ntl.subject(\"the can\", function (t) {\n  var c = camAt(t), p = t < T.pop ? heroAt(t) : [0, -230, 0], s = project(p, c);\n  return { x: s.x, y: s.y, r: (t < T.pop ? 46 : 150) * s.k };\n}, { minPx: 20 });\ntl.rest(T.rest[0], T.rest[1]);\ntl.label(\"rise\", 0.2).label(\"pop\", T.pop).label(\"intro\", T.intro[0]).label(\"peel\", T.peel[0]).label(\"facts\", T.facts[0]).label(\"wrap\", T.wrap[0])\n  .label(\"citrus\", T.citrus[0]).label(\"burst\", T.burst[0]).label(\"wave\", T.wave[0]).label(\"lockup\", T.title);\ntl.hit(\"pop\", T.pop, { kind: \"impact\" }).hit(\"burst\", T.burst[0], { kind: \"impact\" }).hit(\"lockup\", T.title, { kind: \"land\" });\n});</script>",
