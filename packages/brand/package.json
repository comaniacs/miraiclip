{
  "name": "@miraiclip/brand",
  "version": "0.2.1",
  "description": "Brand kits for Miraiclip: colours, fonts, logo, caption style, intro and outro in one JSON object, applied to any project as ordinary commands.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comaniacs/miraiclip.git",
    "directory": "packages/brand"
  },
  "homepage": "https://docs.miraiclip.com/",
  "bugs": {
    "url": "https://github.com/comaniacs/miraiclip/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@miraiclip/registry": "workspace:^",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@miraiclip/core": "workspace:^",
    "@types/node": "^22.20.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "brand-kit",
    "branding",
    "templates",
    "watermark",
    "miraiclip"
  ],
  "peerDependencies": {
    "@miraiclip/core": "workspace:^"
  }
}
