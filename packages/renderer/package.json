{
  "name": "@miraiclip/renderer",
  "version": "0.18.0",
  "description": "Rendering and playback for Miraiclip: WebCodecs media pipeline, WebGL compositor, frame-accurate playback.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comaniacs/miraiclip.git",
    "directory": "packages/renderer"
  },
  "homepage": "https://docs.miraiclip.com/",
  "bugs": {
    "url": "https://github.com/comaniacs/miraiclip/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./export-worker": "./src/export/worker/export.worker.ts",
    "./stage": "./src/stage/index.ts"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./export-worker": {
        "import": {
          "types": "./dist/export.worker.d.ts",
          "default": "./dist/export.worker.js"
        }
      },
      "./stage": {
        "import": {
          "types": "./dist/stage.d.ts",
          "default": "./dist/stage.js"
        },
        "require": {
          "types": "./dist/stage.d.cts",
          "default": "./dist/stage.cjs"
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/bundle-stage.mjs --check && node scripts/bundle-three.mjs --check && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "stage": "node scripts/bundle-stage.mjs && node scripts/bundle-three.mjs",
    "test:browser": "vitest run -c vitest.browser.config.ts"
  },
  "dependencies": {
    "mediabunny": "^1.24.0",
    "pixi.js": "^8.6.0"
  },
  "peerDependencies": {
    "@miraiclip/core": "^0.13.0"
  },
  "devDependencies": {
    "@miraiclip/core": "workspace:*",
    "animejs": "4.5.0",
    "esbuild": "0.27.7",
    "playwright-core": "^1.63.0",
    "three": "0.170.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "zod": "^4.5.4"
  }
}
