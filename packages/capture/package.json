{
  "name": "@miraiclip/capture",
  "version": "0.1.0",
  "description": "Record screen, microphone and camera in the browser with an interaction log (clicks, keys, scrolls, cursor path, sensitive fields) on the same clock — the input for Miraiclip's screencast planners.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comaniacs/miraiclip.git",
    "directory": "packages/capture"
  },
  "homepage": "https://docs.miraiclip.com/",
  "bugs": {
    "url": "https://github.com/comaniacs/miraiclip/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "mediabunny": "^1.55.7"
  },
  "devDependencies": {
    "@miraiclip/core": "workspace:^",
    "@types/node": "^22.20.1",
    "esbuild": "^0.27.7",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.49.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "screen-recording",
    "screencast",
    "tutorial",
    "capture",
    "webcodecs",
    "miraiclip"
  ]
}
