{
  "name": "@miraiclip/server-export",
  "version": "0.1.0",
  "description": "Server-side export for Miraiclip: run exportProject in headless Chrome from Node \u2014 same pipeline as the browser, preview/export parity by construction.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comaniacs/miraiclip.git",
    "directory": "packages/server-export"
  },
  "homepage": "https://comaniacs.github.io/miraiclip/",
  "bugs": {
    "url": "https://github.com/comaniacs/miraiclip/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "miraiclip-export": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "pnpm build && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "playwright-core": "^1.49.0"
  },
  "peerDependencies": {
    "@miraiclip/core": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@miraiclip/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@miraiclip/core": "workspace:*",
    "@miraiclip/renderer": "workspace:*",
    "@types/node": "^22.20.1",
    "mediabunny": "^1.24.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
