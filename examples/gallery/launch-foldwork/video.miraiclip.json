], [2100, -760, -320]];\nvar birds = [0, 1, 2].map(function (k) {\n  var g = el(\"g3 bird\");\n  el(\"wing\", g, \"transform:rotateX(90deg)\"); el(\"wing l\", g, \"transform:rotateX(-90deg)\");\n  return { g: g, k: k, t0: T.birds[0] + 0.45 * k, off: [k * -70, k * 34, (k - 1) * 120] };\n});\nvar bx = curve(BIRD_PATH.map(function (p, i) { return [i, p[0]]; })), by = curve(BIRD_PATH.map(function (p, i) { return [i, p[1]]; })), bz = curve(BIRD_PATH.map(function (p, i) { return [i, p[2]]; }));\nfunction birdAt(b, t) { // position along the path; before take-off it rests on its spot of the left page\n  var u = c01((t - b.t0) / 5.0) * (BIRD_PATH.length - 1), lift = smr(t, b.t0, b.t0 + 0.5);\n  return [bx(u) + b.off[0], by(u) + b.off[1] * lift, bz(u) + b.off[2]];\n}\nfunction poseBirds(t) {\n  birds.forEach(function (b) {\n    var p = birdAt(b, t), q = birdAt(b, t + 0.05), v = V.sub(q, p), flying = t > b.t0;\n    var gone = t > b.t0 + 5.0 || t > T.fold[0];\n    b.g.style.display = gone ? \"none\" : \"block\";\n    if (gone) return;\n    var head = flying && Math.hypot(v[0], v[2]) > 0.01 ? Math.atan2(-v[2], v[0]) : 0.4, pitch = flying ? Math.atan2(v[1], Math.hypot(v[0], v[2]) + 1e-6) : 0;\n    var flap = flying ? 34 * Math.sin(2 * Math.PI * 3.1 * (t - b.t0) + b.k) * smr(t, b.t0, b.t0 + 0.4) : 0;\n    b.g.style.transform = \"translate3d(\" + f2(p[0]) + \"px,\" + f2(p[1]) + \"px,\" + f2(p[2]) + \"px) rotateY(\" + (head / deg).toFixed(2) + \"deg) rotateZ(\" + (pitch / deg).toFixed(2) + \"deg)\";\n    var w = b.g.children;\n    w[0].style.transform = \"rotateX(\" + (90 + flap).toFixed(2) + \"deg)\";\n    w[1].style.transform = \"rotateX(\" + (-90 - flap).toFixed(2) + \"deg)\";\n    b.g.style.opacity = (1 - smr(t, b.t0 + 4.4, b.t0 + 5.0)).toFixed(3);\n  });\n}\n\n// ---- the book closes: the left half swings over the spine, its cover comes up with the mark\nfunction poseBook(t) {\n  var u = smoother((t - T.close[0]) / (T.close[1] - T.close[0]));\n  var ang = 180 * u - 3 * Math.sin(Math.PI * c01((t - T.close[1]) / 0.35)) * (t > T.close[1] ? 1 : 0); // a small settle as it lands\n  leftHalf.style.transform = \"rotateZ(\" + ang.toFixed(3) + \"deg)\";\n  // whichever side faces up is the one drawn: Chrome doesn't cull the cover's back face reliably (its rotated\n  // content escapes backface-visibility), so the swap is explicit, at the moment the half stands on edge\n  cover.style.visibility = ang > 90 ? \"visible\" : \"hidden\";\n  leftPage.style.visibility = ang > 90 ? \"hidden\" : \"visible\";\n}\n\n// ==== film/60-camera.js\n// ---- one camera move for the whole film: [t, yaw, elev, dist, tx, ty, ox, oy], joined by the kit's monotone\n// cubics (distance in log space). It starts as a macro over a blank page and never stops until the held last frame.\nvar CAM = filmCamera([\n  [0.0, 0, 88, 760, 790, 0, 0, 0], //        top-down macro: the blank page, the first crease\n  [3.4, 10, 64, 1150, 800, -60, 0, 0], //    tilting off as the first fold stands\n  [6.4, 24, 38, 2050, 760, -60, 0, 40], //   wide 3/4: the city folds up in a wave\n  [8.8, 34, 26, 2250, 720, -70, 0, 40],\n  [10.4, 52, 9, 1050, 900, -110, 140, 30], // dive to street level, toward the tower\n  [12.7, 66, 7, 900, 1000, -150, 160, 20],\n  [14.8, 88, 13, 1350, 900, -150, 0, 20], //  out of the streets as the light starts to warm\n  [17.6, 118, 22, 1900, 500, -200, 0, 20], // tracking the birds up and over\n  [20.6, 150, 46, 2700, 200, -80, 0, 30],\n  [23.4, 180, 76, 3400, 0, 0, 0, 30], //      the whole spread from above: the plan and the place\n  [25.8, 192, 62, 3150, 300, 0, 0, 0],\n  [28.6, 206, 40, 2650, 800, -20, 0, -110], // the closed book, the hero\n  [30.0, 206, 40, 2650, 800, -20, 0, -110],\n], [[800, 0, 0], [0, 0, -550], [1600, 0, 550], [-800, 0, 0], [800, -300, 0]]);\nvar camAt = CAM.camAt;\n\n// ==== film/70-overlay.js\n// ---- motion graphics: the fold annotation (an angle arc and a counter pinned to the tower's hinge), the coral line\n// (plan → tower in the discovery, the birds' trail in the transformation), and the type. lineIO / fadeIO / drawLine\n// come from the kit.\nvar line = $(\"kline\"), arcPath = $(\"arc\"), arcLab = $(\"arclab\");\nfunction poseAnnotation(t, c) {\n  var b = buildings[1], on = smr(t, T.tower[0] - 0.2, T.tower[0] + 0.3) * (1 - smr(t, T.disc[1] - 0.3, T.disc[1] + 0.2));\n  if (on <= 0) { arcPath.style.opacity = 0; arcLab.style.opacity = 0; return; }\n  var a = foldAngle(b, t) * deg, open = Math.PI / 2 - a, R = 110, H = [b.c[0] + b.c[2] / 2, 0, b.c[1] - b.c[3] / 2];\n  var pts = [];\n  for (var k = 0; k <= 16; k++) { var th = open * k / 16; pts.push(project([H[0], -R * Math.sin(th), H[2] - R * Math.cos(th)], c)); }\n  arcPath.setAttribute(\"d\", \"M\" + pts.map(function (p) { return f2(p.x) + \" \" + f2(p.y); }).join(\" L\"));\n  arcPath.style.opacity = on.toFixed(3);\n  var mid = project([H[0] + 30, -R * 1.25 * Math.sin(open / 2), H[2] - R * 1.25 * Math.cos(open / 2)], c);\n  arcLab.style.transform = \"translate(\" + f2(mid.x + 14) + \"px,\" + f2(mid.y - 30) + \"px)\";\n  arcLab.style.opacity = on.toFixed(3);\n  $(\"arcv\").textContent = Math.round(clamp(open / deg, 0, 99)) + \"°\";\n}\nfunction poseLine(t, c) {\n  var tw = buildings[1], a = foldAngle(tw, t) * deg;\n  if (t > T.tower[0] && t < T.disc[1] + 0.5) { // from the tower's rectangle on the plan to the real tower's roof\n    var from = [tw.c[0] - PW, 0, tw.c[1]], top = [tw.c[0], -tw.c[4] * Math.cos(a), tw.c[1] - tw.c[4] * Math.sin(a)];\n    drawLine(line, [from, [(from[0] + top[0]) / 2, -520, tw.c[1]], top], c, smoother((t - T.tower[0] - 0.4) / 1.2), 1 - smr(t, T.disc[1] - 0.2, T.disc[1] + 0.4));\n  } else if (t > T.birds[0] && t < T.birds[1]) { // the lead bird's trail\n    var pts = [];\n    for (var k = 12; k >= 0; k--) pts.push(birdAt(birds[0], Math.max(T.birds[0], t - k * 0.11)));\n    drawLine(line, pts, c, 1, smr(t, T.birds[0] + 0.3, T.birds[0] + 0.8) * (1 - smr(t, T.birds[1] - 0.8, T.birds[1])));\n  } else line.style.opacity = 0;\n}\nfunction poseType(t) {\n  lineIO(\"h1a\", T.hook, t); lineIO(\"h1b\", [T.hook[0] + 0.2, T.hook[1] + 0.05], t);\n  lineIO(\"h2a\", T.intro, t); lineIO(\"h2b\", [T.intro[0] + 0.2, T.intro[1] + 0.05], t);\n  lineIO(\"h3a\", T.disc, t); lineIO(\"h3b\", [T.disc[0] + 0.2, T.disc[1] + 0.05], t);\n  lineIO(\"h4a\", T.trans, t); lineIO(\"h4b\", [T.trans[0] + 0.2, T.trans[1] + 0.05], t);\n  lineIO(\"h5a\", T.reveal, t); lineIO(\"h5b\", [T.reveal[0] + 0.2, T.reveal[1] + 0.05], t);\n  lineIO(\"tag\", [T.tag, 99], t);\n  fadeIO(\"cta\", T.cta, 99, t, 10);\n}\n\n// ==== film/90-main.js\n// ---- the frame: camera, book, city, birds, overlay, all from t\nfunction paint(t) {\n  var c = camAt(t);\n  $(\"view\").style.transform = \"translate(\" + f2(c.ox) + \"px,\" + f2(c.oy) + \"px)\";\n  world.style.transform = $(\"ground\").style.transform = camTransform(c);\n  poseCity(t); poseLines(t); poseBirds(t); poseBook(t);\n  poseAnnotation(t, c); poseLine(t, c);\n}\ntl.frame(paint, { motion: CAM.motionOf });\ntl.frame(poseType, { hold: true });\n\n// the subject the shot check keeps in frame: the first fold, then the tower, then the book\ntl.subject(\"the city\", function (t) {\n  var c = camAt(t), p = t < 9.6 ? [CITY[0][0], -80, CITY[0][1]] : t < 14.8 ? [CITY[1][0], -120, CITY[1][1]] : [t < 26 ? 400 : 800, -40, 0];\n  var s = project(p, c); return { x: s.x, y: s.y, r: 120 * s.k };\n}, { minPx: 30 });\ntl.rest(28.8, T.DUR);\ntl.label(\"crease\", T.crease[0]).label(\"first\", T.first[0]).label(\"grid\", T.grid[0]).label(\"wave\", T.wave[0]).label(\"dive\", 9.4).label(\"tower\", T.tower[0])\n  .label(\"dusk\", T.dusk[0]).label(\"birds\", T.birds[0]).label(\"mark\", T.mark[0]).label(\"reveal\", T.reveal[0]).label(\"fold\", T.fold[0]).label(\"close\", T.close[0]);\nPOP.forEach(function (p, i) { tl.hit(\"fold\" + i, p, { kind: \"click\" }); });\ntl.hit(\"close\", T.close[1], { kind: \"impact\" });\n});</script>",
