      "template": "<div class=\"stage\" data-libs=\"stage\" data-duration=\"30\" data-fps=\"30\" data-stage-version=\"2\" data-frame-timeout=\"60\" style=\"width:1920px;height:1080px;overflow:hidden\"><style>\n*{box-sizing:border-box;margin:0}\n.stage{background:radial-gradient(ellipse 60% 60% at 50% 45%,#141519 0%,#0a0b0e 55%,#050608 100%);color:#efe9dd}\n#view{position:absolute;left:0;top:0;width:1920px;height:1080px;perspective:1400px;perspective-origin:960px 540px}\n#ground,#world{position:absolute;left:960px;top:540px;width:0;height:0;transform-style:preserve-3d}\n#ground>div{position:absolute}\n.g3{position:absolute;left:0;top:0;width:0;height:0;transform-style:preserve-3d}\n#world>div,.g3>div{position:absolute}\n.table{background:radial-gradient(circle,rgba(255,207,138,0.28) 0%,rgba(120,80,40,0.25) 7%,rgba(30,20,12,0.9) 16%,#0b0806 30%),repeating-linear-gradient(90deg,rgba(255,255,255,0.02) 0 4px,transparent 4px 13px),#0b0806}\n.cup{backface-visibility:hidden;box-shadow:inset 0 2px 0 rgba(255,255,255,0.6)}\n.saucer{border-radius:50%;background:radial-gradient(circle,#efe9e0 0 52%,#d8d0c4 60%,#f4efe8 72%,#c9c1b4 74%,rgba(0,0,0,0.35) 76%,rgba(0,0,0,0) 86%)}\n.handle{border-radius:50%;border:12px solid #ece6dc;box-shadow:inset 0 0 6px rgba(0,0,0,0.25)}\n.tea{border-radius:50%;box-shadow:inset 0 0 12px rgba(0,0,0,0.6)}\n.card{background:linear-gradient(180deg,#f3ede1,#e5ddce);border-radius:4px;box-shadow:0 18px 40px rgba(0,0,0,0.55);padding:22px 12px 0;display:flex;flex-direction:column;align-items:center;gap:8px;font-family:'Bradley Hand','Marker Felt','Noteworthy',cursive;color:#2a2420;backface-visibility:hidden}\n.card b{display:grid;place-items:center;width:146px;height:120px;background:#d9d1c2;font-size:70px;font-weight:400;font-family:'Apple Color Emoji',sans-serif}\n.card span{font-size:19px}\n.card .pin{position:absolute;left:79px;top:6px;width:12px;height:12px;border-radius:50%;background:radial-gradient(circle at 35% 35%,#ff6b6b,#9c0b1f);box-shadow:0 2px 3px rgba(0,0,0,0.5)}\n#spot{position:absolute;inset:0;pointer-events:none;background:radial-gradient(ellipse 45% 55% at 50% 50%,rgba(0,0,0,0) 40%,rgba(0,0,0,0.55) 100%)}\n#teafill{position:absolute;inset:0;background:radial-gradient(circle,#5a2c10,#2a1206 70%,#0a0b0e);opacity:0}\n#marks{position:absolute;left:0;top:0;overflow:visible;pointer-events:none}\n#kline{stroke:#c8102e;filter:url(#paint) drop-shadow(0 0 6px rgba(200,16,46,0.6))}\n#ring{fill:none;stroke:#c8102e;stroke-width:16;stroke-linecap:round;stroke-dasharray:1 1.02;filter:url(#paint)}\n.eye{fill:#c8102e;filter:url(#paint)}\n#lead{fill:none;stroke:rgba(239,233,221,0.85);stroke-width:1.6;stroke-dasharray:1 1.02}\n#ded{position:absolute;left:1080px;max-width:760px;padding:18px 26px 20px;border-radius:10px;background:rgba(8,9,12,0.88);box-shadow:0 10px 40px rgba(0,0,0,0.6);opacity:0;font-family:'Avenir Next','Helvetica Neue',Arial,sans-serif}\n#ded small{display:block;font-weight:600;font-size:20px;letter-spacing:0.22em;text-transform:uppercase;color:#ffcf8a}\n#ded b{display:block;font-family:'Bradley Hand','Marker Felt','Noteworthy',cursive;font-weight:400;font-size:44px;color:#efe9dd;margin-top:6px}\n#ov{position:absolute;left:0;top:0;width:1920px;height:1080px;pointer-events:none;font-family:'Avenir Next','Helvetica Neue',Arial,sans-serif;-webkit-font-smoothing:antialiased}\n.cap{position:absolute;left:130px;overflow:hidden;padding:6px 0 12px;font-weight:500;font-size:58px;line-height:1.08;letter-spacing:-0.01em;white-space:nowrap;color:#efe9dd;text-shadow:0 2px 30px rgba(0,0,0,0.8)}\n.cap>span{display:inline-block}.cap .r{color:#e0293f}\n#title{position:absolute;left:0;width:1920px;top:430px;text-align:center;font-family:'Didot','Bodoni 72','Iowan Old Style',Georgia,serif;font-weight:400;font-size:132px;letter-spacing:0.22em;padding-left:0.22em;color:#f3ede1;opacity:0;text-shadow:0 4px 40px rgba(0,0,0,0.9)}\n#tag{left:0;width:1920px;top:600px;text-align:center;font-size:40px}\n#cta{position:absolute;left:0;width:1920px;top:700px;text-align:center;opacity:0}\n#cta span{display:inline-block;padding:13px 34px;border:1.5px solid rgba(243,237,225,0.6);border-radius:40px;font-weight:600;font-size:22px;letter-spacing:0.12em;text-transform:uppercase}\n#fan{position:absolute;left:0;width:1920px;top:1010px;text-align:center;font-size:17px;color:rgba(239,233,221,0.55);opacity:0}\n</style>\n<div id=\"view\"><div id=\"ground\"></div><div id=\"world\"></div></div><div id=\"teafill\"></div><div id=\"spot\"></div>\n<svg id=\"marks\" width=\"1920\" height=\"1080\"><defs><filter id=\"paint\" x=\"-20%\" y=\"-20%\" width=\"140%\" height=\"140%\"><feTurbulence type=\"fractalNoise\" baseFrequency=\"0.04\" numOctaves=\"2\" seed=\"7\"/><feDisplacementMap in=\"SourceGraphic\" scale=\"7\"/></filter></defs>\n<path id=\"lead\" d=\"\" pathLength=\"1\" style=\"opacity:0\"/><path id=\"kline\" d=\"\" fill=\"none\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"opacity:0\"/>\n<ellipse id=\"eyeL\" class=\"eye\" rx=\"0\" ry=\"0\"/><ellipse id=\"eyeR\" class=\"eye\" rx=\"0\" ry=\"0\"/><circle id=\"ring\" r=\"0\" pathLength=\"1\" style=\"opacity:0\"/></svg>\n<div id=\"ov\">\n<div class=\"cap\" id=\"h1\" style=\"top:820px;opacity:0;\"><span>Look <span class=\"r\">closer.</span></span></div>\n<div class=\"cap\" id=\"h2\" style=\"top:820px;opacity:0;\"><span>Every lie leaves a trace.</span></div>\n<div id=\"ded\"><small id=\"dk\"></small><b id=\"dv\"></b></div>\n<div class=\"cap\" id=\"h3\" style=\"top:820px;opacity:0;\"><span>Every detail <span class=\"r\">matters.</span></span></div>\n<div class=\"cap\" id=\"h4\" style=\"top:110px;opacity:0;left:0;width:1920px;text-align:center\"><span><span class=\"r\">Some patterns are a warning.</span></span></div>\n<div id=\"title\">THE MENTALIST</div>\n<div class=\"cap\" id=\"tag\" style=\"top:600px;opacity:0;left:0;width:1920px;text-align:center;font-size:40px\"><span>All seven seasons. Every detail <span class=\"r\">matters.</span></span></div>\n<div id=\"cta\"><span>Stream the complete series</span></div>\n<div id=\"fan\">Fan-made promo. Not affiliated with or endorsed by CBS or Warner Bros. Television.</div></div></div>\n<script>stage.build((tl, S) => {var W = 1920, H = 1080, PERSP = 1400, WIN_W = 0, WIN_H = 0;\nvar T = {\"DUR\":30,\"FPS\":30,\"look\":[1,4.2],\"dive\":[4.4,6.4],\"intro\":[6.6,9],\"deds\":[[9.2,11],[11.1,12.9],[13,14.9]],\"string\":[15,20.6],\"exp\":[15.6,20.2],\"align\":[20.8,23],\"smile\":[22.4,24.6],\"warn\":[23.6,25.6],\"title\":26,\"tag\":26.6,\"cta\":27.2,\"rest\":[28.6,30]};\n// ---- app-film kit · film-core: easing, a tiny vector kit, monotone keyframe curves and the CSS-3D projection.\n// The build defines W, H and PERSP before this file. Units are CSS pixels in world space, y down; +z is toward the\n// camera. Everything is a pure function of its inputs so frames are deterministic.\nvar $ = function (id) { return document.getElementById(id); };\nvar clamp = function (x, a, b) { return Math.max(a, Math.min(b, x)); };\nvar c01 = function (x) { return clamp(x, 0, 1); };\nvar sm = function (x) { x = c01(x); return x * x * (3 - 2 * x); };\nvar smr = function (t, a, b) { return sm((t - a) / (b - a)); };\nvar smoother = function (x) { x = c01(x); return x * x * x * (x * (x * 6 - 15) + 10); };\nvar mix = function (a, b, u) { return a + (b - a) * u; };\nvar expOut = function (x) { x = c01(x); return x >= 1 ? 1 : 1 - Math.pow(2, -10 * x); };\nvar deg = Math.PI / 180;\nvar f2 = function (x) { return x.toFixed(2); };\n\nvar V = {\n  add: function (a, b) { return [a[0] + b[0], a[1] + b[1], a[2] + b[2]]; },\n  sub: function (a, b) { return [a[0] - b[0], a[1] - b[1], a[2] - b[2]]; },\n  mul: function (a, s) { return [a[0] * s, a[1] * s, a[2] * s]; },\n  dot: function (a, b) { return a[0] * b[0] + a[1] * b[1] + a[2] * b[2]; },\n  norm: function (a) { var l = Math.hypot(a[0], a[1], a[2]) || 1; return [a[0] / l, a[1] / l, a[2] / l]; },\n};\n\n// Monotone cubic (Fritsch–Carlson) through keyframes: C1-continuous, so speed never jumps at a key, and no\n// overshoot, so the camera never swings past a framing and back.\nfunction curve(keys) {\n  var n = keys.length, xs = keys.map(function (k) { return k[0]; }), ys = keys.map(function (k) { return k[1]; });\n  var d = [], m = [];\n  for (var i = 0; i < n - 1; i++) d.push((ys[i + 1] - ys[i]) / (xs[i + 1] - xs[i]));\n  m[0] = 0; m[n - 1] = 0; // start and end at rest\n  for (i = 1; i < n - 1; i++) m[i] = d[i - 1] * d[i] <= 0 ? 0 : (d[i - 1] + d[i]) / 2;\n  for (i = 0; i < n - 1; i++) {\n    if (d[i] === 0) { m[i] = m[i + 1] = 0; continue; }\n    var a = m[i] / d[i], b = m[i + 1] / d[i], s = a * a + b * b;\n    if (s > 9) { var tau = 3 / Math.sqrt(s); m[i] = tau * a * d[i]; m[i + 1] = tau * b * d[i]; }\n  }\n  return function (x) {\n    if (x <= xs[0]) return ys[0];\n    if (x >= xs[n - 1]) return ys[n - 1];\n    var k = 0; while (x > xs[k + 1]) k++;\n    var h = xs[k + 1] - xs[k], u = (x - xs[k]) / h, u2 = u * u, u3 = u2 * u;\n    return (2 * u3 - 3 * u2 + 1) * ys[k] + (u3 - 2 * u2 + u) * h * m[k] + (-2 * u3 + 3 * u2) * ys[k + 1] + (u3 - u2) * h * m[k + 1];\n  };\n}\n\n// The camera is a pose { yaw, elev, dist, tgt, ox, oy } (degrees, px). The world element gets\n//   translateZ(PERSP - dist) rotateX(-elev) rotateY(yaw) translate3d(-tgt)\n// inside a perspective of PERSP, and the whole view is shifted by (ox, oy) on screen. project() is the same maths,\n// so overlay lines and the shot check land exactly on what CSS draws. dist = PERSP at yaw = elev = 0 shows the\n// plane z = 0 at exactly 1:1 pixels.\nfunction camTransform(c) {\n  return \"translateZ(\" + f2(PERSP - c.dist) + \"px) rotateX(\" + (-c.elev).toFixed(3) + \"deg) rotateY(\" + c.yaw.toFixed(3) + \"deg) translate3d(\" + f2(-c.tgt[0]) + \"px,\" + f2(-c.tgt[1]) + \"px,\" + f2(-c.tgt[2]) + \"px)\";\n}\nfunction toView(p, c) {\n  var q = V.sub(p, c.tgt), a = c.yaw * deg, e = -c.elev * deg;\n  var x1 = Math.cos(a) * q[0] + Math.sin(a) * q[2], z1 = -Math.sin(a) * q[0] + Math.cos(a) * q[2], y1 = q[1]; // rotateY\n  var y2 = Math.cos(e) * y1 - Math.sin(e) * z1, z2 = Math.sin(e) * y1 + Math.cos(e) * z1; // rotateX\n  return [x1, y2, z2 + PERSP - c.dist];\n}\nfunction project(p, c) {\n  var v = toView(p, c), k = PERSP / (PERSP - v[2]);\n  return { x: W / 2 + c.ox + v[0] * k, y: H / 2 + c.oy + v[1] * k, k: k, behind: v[2] >= PERSP - 1 };\n}\n// where the camera is in the world: the inverse of the two rotations applied to (0, 0, dist)\nfunction camPos(c) {\n  var a = c.yaw * deg, e = -c.elev * deg;\n  var y = Math.sin(e) * c.dist, z = Math.cos(e) * c.dist;\n  return [c.tgt[0] - Math.sin(a) * z, c.tgt[1] + y, c.tgt[2] + Math.cos(a) * z];\n}\n\n// One camera from keys [t, yaw, elev, dist, tx, ty, ox, oy]: each channel a monotone cubic, distance in log space so\n// push-ins feel constant-speed. probes (world points) size motion blur and check declared rests.\nfunction filmCamera(keys, probes) {\n  var CH = [1, 2, 4, 5, 6, 7].map(function (j) { return curve(keys.map(function (k) { return [k[0], k[j]]; })); });\n  var LOGD = curve(keys.map(function (k) { return [k[0], Math.log(k[3])]; }));\n  function camAt(t) { return { yaw: CH[0](t), elev: CH[1](t), dist: Math.exp(LOGD(t)), tgt: [CH[2](t), CH[3](t), 0], ox: CH[4](t), oy: CH[5](t) }; }\n  function motionOf(from, to) {\n    var a = camAt(from), b = camAt(to), far = 0;\n    probes.forEach(function (p) { var pa = project(p, a), pb = project(p, b); far = Math.max(far, Math.hypot(pb.x - pa.x, pb.y - pa.y)); });\n    return far;\n  }\n  return { camAt: camAt, motionOf: motionOf };\n}\n\n// ---- app-film kit · overlay: placing things around the app window, carrying snapshots between screens, the cursor\n// and its clicks, the accent line through 3D points, reveal wipes, underlines and masked headlines. All set from t.\n// The build defines WIN_W and WIN_H (the window size); the window is the plane z = 0, centred on the origin.\nfunction w2w(x, y, z) { return [x - WIN_W / 2, y - WIN_H / 2, z || 0]; } // window coords → world\n/** a window-space rect, lifted to z (and optionally rotated/scaled by extra) */\nfunction place(el, x, y, z, w, h, extra) {\n  el.style.width = f2(w) + \"px\"; el.style.height = f2(h) + \"px\";\n  el.style.transform = \"translate3d(\" + f2(x - WIN_W / 2) + \"px,\" + f2(y - WIN_H / 2) + \"px,\" + f2(z || 0) + \"px)\" + (extra || \"\");\n}\nfunction mk(cls, parent, html) { var e = document.createElement(\"div\"); e.className = cls; if (html != null) e.innerHTML = html; parent.appendChild(e); return e; }\nfunction arc(u) { return Math.sin(Math.PI * c01(u)); }\nfunction setHtml(el, html) { if (el.dataset.src !== html) { el.innerHTML = html; el.dataset.src = html; } }\n\n/**\n * A snapshot of a real panel ({ html, rect } from the replay) flies from where it was to `to` (a rect, or null to\n * hide), arcing toward the camera and fading as it lands. keep = 1 scales uniformly (by width); else it squashes to\n * the target's height and fades by the middle.\n */\nfunction flyClone(el, cap, to, span, t, keep) {\n  if (!cap || !to || t < span[0] || t >= span[1]) { el.style.display = \"none\"; return; }\n  setHtml(el, cap.html);\n  var u = smoother((t - span[0]) / (span[1] - span[0])), r = cap.rect;\n  var s = mix(1, to.w / r.w, u), sy = keep === 1 ? s : mix(1, to.h / r.h, u);\n  el.style.display = \"block\"; el.style.width = r.w + \"px\"; el.style.height = r.h + \"px\"; el.style.transformOrigin = \"0 0\";\n  el.style.transform = \"translate3d(\" + f2(mix(r.x, to.x, u) - WIN_W / 2) + \"px,\" + f2(mix(r.y, to.y, u) - WIN_H / 2) + \"px,\" + f2(180 * arc(u)) + \"px) scale(\" + s.toFixed(4) + \",\" + sy.toFixed(4) + \")\";\n  el.style.opacity = (1 - smr(u, keep === 1 ? 0.88 : 0.55, 1)).toFixed(3);\n}\n/** a snapshot that leaves the window and floats at a hero position { x, y, z, scale, rotY } */\nfunction heroClone(el, cap, to, u) {\n  if (!cap || u <= 0) { el.style.display = \"none\"; return; }\n  setHtml(el, cap.html);\n  var r = cap.rect;\n  el.style.display = \"block\"; el.style.width = r.w + \"px\"; el.style.height = r.h + \"px\"; el.style.transformOrigin = \"0 0\";\n  el.style.transform = \"translate3d(\" + f2(mix(r.x, to.x, u) - WIN_W / 2) + \"px,\" + f2(mix(r.y, to.y, u) - WIN_H / 2) + \"px,\" + f2(mix(0, to.z, u)) + \"px) rotateY(\" + (to.rotY * u).toFixed(2) + \"deg) scale(\" + mix(0.3, to.scale, u).toFixed(4) + \")\";\n  el.style.opacity = smr(u, 0, 0.35).toFixed(3);\n}\n\n// ---- the cursor: it travels to each action's target just before the action, arcing a little, presses on clicks,\n// and leaves a ring where it clicked. opts: { home: {x, y}, visible: [in, out] }\nfunction actionPoint(r, kind) { return kind === \"type\" || kind === \"retype\" || kind === \"focus\" ? { x: r.x + Math.min(40, r.w / 2), y: r.y + Math.min(26, r.h / 2) } : { x: r.x + r.w / 2, y: r.y + r.h / 2 }; }\nfunction poseCursor(cursor, ripple, t, rec, R, actions, opts) {\n  var prev = -1, next = -1;\n  actions.forEach(function (a, i) { if (a.t <= t) prev = i; else if (next < 0) next = i; });\n  var from = prev >= 0 ? actionPoint(rec.at[prev], actions[prev].kind) : opts.home, at = from;\n  if (next >= 0) {\n    var el = R.q(actions[next].sel);\n    if (el) {\n      var to = actionPoint(R.rect(el), actions[next].kind), a0 = Math.max(prev >= 0 ? actions[prev].t + (actions[prev].dur || 0) + 0.12 : 0, actions[next].t - 0.7);\n      var u = smoother((t - a0) / (actions[next].t - 0.06 - a0));\n      at = { x: mix(from.x, to.x, u), y: mix(from.y, to.y, u) - 30 * Math.sin(Math.PI * u) };\n    }\n  }\n  var press = 0;\n  actions.forEach(function (a) { if (a.kind === \"click\") press = Math.max(press, Math.exp(-Math.pow((t - a.t) / 0.07, 2))); });\n  cursor.style.transform = \"translate(\" + f2(at.x) + \"px,\" + f2(at.y) + \"px) scale(\" + (1 - 0.14 * press).toFixed(3) + \")\";\n  cursor.style.opacity = (smr(t, opts.visible[0], opts.visible[0] + 0.3) * (1 - smr(t, opts.visible[1], opts.visible[1] + 0.4))).toFixed(3);\n  var c = -1;\n  actions.forEach(function (a, i) { if (a.kind === \"click\" && a.t <= t && t - a.t < 0.5) c = i; });\n  if (c >= 0) {\n    var p = actionPoint(rec.at[c], \"click\"), k = (t - actions[c].t) / 0.5;\n    ripple.style.display = \"block\";\n    ripple.style.transform = \"translate(\" + f2(p.x) + \"px,\" + f2(p.y) + \"px) scale(\" + (0.3 + 1.4 * expOut(k)).toFixed(3) + \")\";\n    ripple.style.opacity = (0.9 * (1 - k)).toFixed(3);\n  } else ripple.style.display = \"none\";\n}\n\n/** a wipe over a real element's rect, top to bottom, with a glowing edge (the app shows it all at once) */\nfunction revealMask(mask, r, u) {\n  if (!r || u <= 0 || u >= 1) { mask.style.display = \"none\"; return; }\n  var top = r.y + 2 + (r.h - 4) * u;\n  mask.style.display = \"block\";\n  mask.style.left = r.x + 2 + \"px\"; mask.style.width = r.w - 4 + \"px\"; mask.style.top = f2(top) + \"px\"; mask.style.height = f2(r.y + r.h - 2 - top) + \"px\";\n}\n/** an accent bar under a real element's rect */\nfunction underline(bar, r, on) {\n  if (!r || on <= 0) { bar.style.display = \"none\"; return; }\n  bar.style.display = \"block\"; bar.style.left = r.x + \"px\"; bar.style.top = r.y + r.h + 1 + \"px\"; bar.style.width = Math.max(8, r.w) + \"px\";\n  bar.style.opacity = on.toFixed(3);\n}\n\n// ---- the accent line: one stroke through 3D points, projected, smoothed (Catmull-Rom → Bézier), drawn up to a share\nfunction drawLine(path, worldPts, c, share, alpha) {\n  if (worldPts.length < 2 || share <= 0 || alpha <= 0) { path.style.opacity = 0; return; }\n  var P = worldPts.map(function (p) { return project(p, c); }), d = \"M\" + f2(P[0].x) + \" \" + f2(P[0].y);\n  for (var i = 0; i < P.length - 1; i++) {\n    var p0 = P[Math.max(0, i - 1)], p1 = P[i], p2 = P[i + 1], p3 = P[Math.min(P.length - 1, i + 2)];\n    d += \" C\" + f2(p1.x + (p2.x - p0.x) / 6) + \" \" + f2(p1.y + (p2.y - p0.y) / 6) + \" \" + f2(p2.x - (p3.x - p1.x) / 6) + \" \" + f2(p2.y - (p3.y - p1.y) / 6) + \" \" + f2(p2.x)