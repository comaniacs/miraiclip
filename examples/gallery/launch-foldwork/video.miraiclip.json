      "template": "<div class=\"stage\" data-libs=\"stage\" data-duration=\"30\" data-fps=\"30\" data-stage-version=\"2\" data-frame-timeout=\"60\" style=\"width:1920px;height:1080px;overflow:hidden\"><style>\n*{box-sizing:border-box;margin:0}\n.stage{background:radial-gradient(ellipse 70% 60% at 50% 42%,#1d2130 0%,#11131b 55%,#0b0c11 100%);color:#f5f1e8}\n#view{position:absolute;left:0;top:0;width:1920px;height:1080px;perspective:1400px;perspective-origin:960px 540px}\n#ground,#world{position:absolute;left:960px;top:540px;width:0;height:0;transform-style:preserve-3d}\n.g3{position:absolute;left:0;top:0;width:0;height:0;transform-style:preserve-3d}\n#world>div,.g3>div{position:absolute}\n.table{position:absolute;left:-5000px;top:-5000px;width:10000px;height:10000px;transform:translateY(32px) rotateX(90deg);background:radial-gradient(circle at 50% 50%,rgba(70,78,104,0.55) 0%,rgba(30,34,48,0.5) 14%,rgba(14,16,22,0) 34%)}\n.bookshadow{position:absolute;left:-1750px;top:-680px;width:3500px;height:1360px;transform:translateY(31px) rotateX(90deg);border-radius:40px;background:rgba(0,0,0,0.55);filter:blur(30px)}\n.page{background:linear-gradient(90deg,rgba(0,0,0,0.10),rgba(0,0,0,0) 6%),repeating-linear-gradient(17deg,rgba(120,100,70,0.025) 0 2px,transparent 2px 7px),#f2ede3;backface-visibility:hidden;overflow:hidden}\n.page.left{background:linear-gradient(270deg,rgba(0,0,0,0.12),rgba(0,0,0,0) 6%),repeating-linear-gradient(-17deg,rgba(120,100,70,0.025) 0 2px,transparent 2px 7px),#f0ebe0}\n.page svg{position:absolute;left:0;top:0;overflow:visible}\n.pool{position:absolute;inset:0;background:radial-gradient(ellipse 60% 70% at 45% 45%,rgba(255,250,235,0.35),rgba(255,250,235,0) 70%)}\n.dim{position:absolute;inset:0;background:#0f1424;opacity:0}\n.creases path,.creases line{fill:none;stroke:rgba(80,70,55,0.35);stroke-width:2;stroke-dasharray:6 6}\n.creases .st{stroke:rgba(80,70,55,0.22);stroke-width:2}\n.creases .first{stroke:#ff5b3a;stroke-width:4;stroke-linecap:round;filter:drop-shadow(0 0 8px rgba(255,91,58,0.9))}\n.plan line{stroke:rgba(40,70,140,0.22);stroke-width:2}\n.plan rect{fill:rgba(40,70,140,0.05);stroke:#2c4a8c;stroke-width:3}\n.plan rect.hot{stroke:#ff5b3a;fill:rgba(255,91,58,0.12)}\n.plan .mark{fill:#ff5b3a;fill-opacity:0;stroke:#ff5b3a;stroke-width:6;stroke-linejoin:round}\n.plan .mark.fold{fill:#c43d24}\n.plan-label{font:600 22px 'Avenir Next','Helvetica Neue',Arial,sans-serif;letter-spacing:0.24em;fill:rgba(44,74,140,0.6)}\n.edge{background:repeating-linear-gradient(180deg,#e9e3d6 0 2px,#d6cfbf 2px 3px);backface-visibility:hidden}\n.cover{background:radial-gradient(ellipse at 40% 35%,#26315a,#1b2440 60%,#151c33),#1b2440;backface-visibility:hidden;box-shadow:inset 0 0 0 10px #172039,inset 0 0 0 12px rgba(255,91,58,0.35)}\n.cover-in{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:26px;font-family:'Avenir Next','Helvetica Neue',Arial,sans-serif}\n.cover-in svg path{fill:#ff5b3a}.cover-in svg path.fold{fill:#b8371f}\n.cover-in b{font-weight:600;font-size:150px;letter-spacing:0.18em;color:#f2d9c4;text-shadow:0 2px 0 rgba(0,0,0,0.35)}\n.cover-in span{font-weight:500;font-size:46px;color:rgba(242,217,196,0.75)}\n.face{backface-visibility:hidden;overflow:hidden;box-shadow:inset 0 0 0 1px rgba(90,80,60,0.18)}\n.face .wins{position:absolute;left:14%;right:14%;top:12%;bottom:10%;background-image:linear-gradient(rgba(60,56,48,0.28) 0 16px,transparent 16px),linear-gradient(90deg,rgba(242,237,227,1) 0 8px,transparent 8px);background-blend-mode:normal;opacity:0.85}\n.face .glow{position:absolute;left:14%;right:14%;top:12%;bottom:10%;opacity:var(--glow,0);background-image:linear-gradient(rgba(255,180,92,1) 0 16px,transparent 16px),linear-gradient(90deg,rgba(0,0,0,0) 0 8px,transparent 8px);background-size:inherit;filter:drop-shadow(0 0 6px rgba(255,170,80,0.9))}\n.face.roof{box-shadow:inset 0 0 0 2px rgba(90,80,60,0.2)}\n.shadow{position:absolute;border-radius:10px;background:rgba(40,30,20,0.55);filter:blur(10px);opacity:0}\n.wing{left:-70px;top:0;width:140px;height:64px;transform-origin:50% 0;background:linear-gradient(180deg,#fbf8f1,#e7e1d4);clip-path:polygon(0 0,100% 0,18% 100%)}\n#kl{position:absolute;left:0;top:0;overflow:visible;pointer-events:none}\n#ov{position:absolute;left:0;top:0;width:1920px;height:1080px;pointer-events:none;font-family:'Avenir Next','Helvetica Neue',Arial,sans-serif;-webkit-font-smoothing:antialiased}\n.cap{position:absolute;left:120px;overflow:hidden;padding:6px 0 12px;font-weight:600;font-size:64px;line-height:1.08;letter-spacing:-0.02em;white-space:nowrap;color:#f5f1e8;text-shadow:0 2px 30px rgba(8,9,14,0.6)}\n.cap>span{display:inline-block}.cap .c{color:#ff7a5c}\n#h1a,#h1b{color:#1c2030;text-shadow:none}#h1b .c{color:#e8492c}\n#arclab{position:absolute;left:0;top:0;opacity:0;font-family:'Avenir Next','Helvetica Neue',Arial,sans-serif;text-shadow:0 2px 16px rgba(8,9,14,0.8)}\n#arclab small{display:block;font-weight:600;font-size:18px;letter-spacing:0.26em;color:#ffb39f}\n#arclab b{font-weight:600;font-size:52px;color:#fff;font-variant-numeric:tabular-nums}\n#tag{left:0;width:1920px;top:900px;text-align:center;font-size:44px;font-weight:500;color:rgba(245,241,232,0.9)}\n#cta{position:absolute;left:0;width:1920px;top:982px;text-align:center}\n#cta span{display:inline-block;padding:13px 34px;border-radius:40px;background:#ff5b3a;color:#fff;font-weight:600;font-size:22px;letter-spacing:0.04em;box-shadow:0 10px 30px rgba(255,91,58,0.4)}\n</style>\n<div id=\"view\"><div id=\"ground\"><div class=\"table\"></div><div class=\"bookshadow\"></div></div><div id=\"world\"></div></div>\n<svg id=\"kl\" width=\"1920\" height=\"1080\"><path id=\"arc\" d=\"\" fill=\"none\" stroke=\"#ffb39f\" stroke-width=\"3\" stroke-dasharray=\"2 8\" stroke-linecap=\"round\" style=\"opacity:0\"/><path id=\"kline\" d=\"\" fill=\"none\" stroke=\"#ff5b3a\" stroke-width=\"3.5\" stroke-linecap=\"round\" style=\"opacity:0;filter:drop-shadow(0 0 7px rgba(255,91,58,0.8))\"/></svg>\n<div id=\"ov\">\n<div class=\"cap\" id=\"h1a\" style=\"top:430px;opacity:0;\"><span>Every world</span></div><div class=\"cap\" id=\"h1b\" style=\"top:500px;opacity:0;\"><span>starts <span class=\"c\">flat.</span></span></div>\n<div class=\"cap\" id=\"h2a\" style=\"top:120px;opacity:0;\"><span>Fold by fold,</span></div><div class=\"cap\" id=\"h2b\" style=\"top:190px;opacity:0;\"><span>it takes shape.</span></div>\n<div class=\"cap\" id=\"h3a\" style=\"top:120px;opacity:0;\"><span>Every crease,</span></div><div class=\"cap\" id=\"h3b\" style=\"top:190px;opacity:0;\"><span>a <span class=\"c\">plan.</span></span></div>\n<div class=\"cap\" id=\"h4a\" style=\"top:120px;opacity:0;\"><span>Every plan,</span></div><div class=\"cap\" id=\"h4b\" style=\"top:190px;opacity:0;\"><span>a <span class=\"c\">place.</span></span></div>\n<div class=\"cap\" id=\"h5a\" style=\"top:120px;opacity:0;\"><span>From flat plans</span></div><div class=\"cap\" id=\"h5b\" style=\"top:190px;opacity:0;\"><span>to <span class=\"c\">living worlds.</span></span></div>\n<div id=\"arclab\"><small>FOLD</small><b id=\"arcv\">0°</b></div>\n<div class=\"cap\" id=\"tag\" style=\"top:900px;opacity:0;\"><span>Foldwork turns flat plans into worlds you can walk through.</span></div>\n<div id=\"cta\" style=\"opacity:0\"><span>Unfold yours</span></div></div></div>\n<script>stage.build((tl, S) => {var W = 1920, H = 1080, PERSP = 1400, WIN_W = 0, WIN_H = 0;\nvar T = {\"DUR\":30,\"FPS\":30,\"crease\":[0.3,1.9],\"first\":[2,3.4],\"hook\":[0.5,3.6],\"grid\":[4,6],\"wave\":[4.4,8.2],\"intro\":[4.6,8.4],\"tower\":[10.2,12.6],\"disc\":[11,14.4],\"dusk\":[15,18],\"birds\":[15.6,21.5],\"trans\":[16.2,20.4],\"mark\":[21.6,24.4],\"reveal\":[22,25.6],\"fold\":[25.8,27.2],\"close\":[26.6,28.4],\"tag\":28,\"cta\":28.5};\nvar CITY = [[760,40,150,110,210],[1040,-120,120,120,330],[560,-150,130,100,170],[950,200,140,100,150],[600,230,110,90,120],[1180,120,130,110,240],[380,20,120,100,140],[1250,-250,140,110,190],[800,-300,160,100,120],[420,-330,110,90,200],[1420,30,110,120,130],[230,260,120,90,100],[1400,330,120,90,160],[260,-170,100,90,120],[1100,380,130,80,110],[560,420,140,70,90]];\nvar popTimes = function popTimes() {\n  const [x0, z0] = CITY[0], rest = CITY.map((c, i) => ({ i, d: Math.hypot(c[0] - x0, c[1] - z0) })).filter((o) => o.i > 1).sort((a, b) => a.d - b.d);\n  const out = [];\n  out[0] = T.first[0]; out[1] = T.tower[0];\n  rest.forEach((o, k) => { out[o.i] = +(T.wave[0] + (T.wave[1] - T.wave[0] - 0.8) * k / (rest.length - 1)).toFixed(3); });\n  return out;\n};\n// ---- app-film kit · film-core: easing, a tiny vector kit, monotone keyframe curves and the CSS-3D projection.\n// The build defines W, H and PERSP before this file. Units are CSS pixels in world space, y down; +z is toward the\n// camera. Everything is a pure function of its inputs so frames are deterministic.\nvar $ = function (id) { return document.getElementById(id); };\nvar clamp = function (x, a, b) { return Math.max(a, Math.min(b, x)); };\nvar c01 = function (x) { return clamp(x, 0, 1); };\nvar sm = function (x) { x = c01(x); return x * x * (3 - 2 * x); };\nvar smr = function (t, a, b) { return sm((t - a) / (b - a)); };\nvar smoother = function (x) { x = c01(x); return x * x * x * (x * (x * 6 - 15) + 10); };\nvar mix = function (a, b, u) { return a + (b - a) * u; };\nvar expOut = function (x) { x = c01(x); return x >= 1 ? 1 : 1 - Math.pow(2, -10 * x); };\nvar deg = Math.PI / 180;\nvar f2 = function (x) { return x.toFixed(2); };\n\nvar V = {\n  add: function (a, b) { return [a[0] + b[0], a[1] + b[1], a[2] + b[2]]; },\n  sub: function (a, b) { return [a[0] - b[0], a[1] - b[1], a[2] - b[2]]; },\n  mul: function (a, s) { return [a[0] * s, a[1] * s, a[2] * s]; },\n  dot: function (a, b) { return a[0] * b[0] + a[1] * b[1] + a[2] * b[2]; },\n  norm: function (a) { var l = Math.hypot(a[0], a[1], a[2]) || 1; return [a[0] / l, a[1] / l, a[2] / l]; },\n};\n\n// Monotone cubic (Fritsch–Carlson) through keyframes: C1-continuous, so speed never jumps at a key, and no\n// overshoot, so the camera never swings past a framing and back.\nfunction curve(keys) {\n  var n = keys.length, xs = keys.map(function (k) { return k[0]; }), ys = keys.map(function (k) { return k[1]; });\n  var d = [], m = [];\n  for (var i = 0; i < n - 1; i++) d.push((ys[i + 1] - ys[i]) / (xs[i + 1] - xs[i]));\n  m[0] = 0; m[n - 1] = 0; // start and end at rest\n  for (i = 1; i < n - 1; i++) m[i] = d[i - 1] * d[i] <= 0 ? 0 : (d[i - 1] + d[i]) / 2;\n  for (i = 0; i < n - 1; i++) {\n    if (d[i] === 0) { m[i] = m[i + 1] = 0; continue; }\n    var a = m[i] / d[i], b = m[i + 1] / d[i], s = a * a + b * b;\n    if (s > 9) { var tau = 3 / Math.sqrt(s); m[i] = tau * a * d[i]; m[i + 1] = tau * b * d[i]; }\n  }\n  return function (x) {\n    if (x <= xs[0]) return ys[0];\n    if (x >= xs[n - 1]) return ys[n - 1];\n    var k = 0; while (x > xs[k + 1]) k++;\n    var h = xs[k + 1] - xs[k], u = (x - xs[k]) / h, u2 = u * u, u3 = u2 * u;\n    return (2 * u3 - 3 * u2 + 1) * ys[k] + (u3 - 2 * u2 + u) * h * m[k] + (-2 * u3 + 3 * u2) * ys[k + 1] + (u3 - u2) * h * m[k + 1];\n  };\n}\n\n// The camera is a pose { yaw, elev, dist, tgt, ox, oy } (degrees, px). The world element gets\n//   translateZ(PERSP - dist) rotateX(-elev) rotateY(yaw) translate3d(-tgt)\n// inside a perspective of PERSP, and the whole view is shifted by (ox, oy) on screen. project() is the same maths,\n// so overlay lines and the shot check land exactly on what CSS draws. dist = PERSP at yaw = elev = 0 shows the\n// plane z = 0 at exactly 1:1 pixels.\nfunction camTransform(c) {\n  return \"translateZ(\" + f2(PERSP - c.dist) + \"px) rotateX(\" + (-c.elev).toFixed(3) + \"deg) rotateY(\" + c.yaw.toFixed(3) + \"deg) translate3d(\" + f2(-c.tgt[0]) + \"px,\" + f2(-c.tgt[1]) + \"px,\" + f2(-c.tgt[2]) + \"px)\";\n}\nfunction toView(p, c) {\n  var q = V.sub(p, c.tgt), a = c.yaw * deg, e = -c.elev * deg;\n  var x1 = Math.cos(a) * q[0] + Math.sin(a) * q[2], z1 = -Math.sin(a) * q[0] + Math.cos(a) * q[2], y1 = q[1]; // rotateY\n  var y2 = Math.cos(e) * y1 - Math.sin(e) * z1, z2 = Math.sin(e) * y1 + Math.cos(e) * z1; // rotateX\n  return [x1, y2, z2 + PERSP - c.dist];\n}\nfunction project(p, c) {\n  var v = toView(p, c), k = PERSP / (PERSP - v[2]);\n  return { x: W / 2 + c.ox + v[0] * k, y: H / 2 + c.oy + v[1] * k, k: k, behind: v[2] >= PERSP - 1 };\n}\n// where the camera is in the world: the inverse of the two rotations applied to (0, 0, dist)\nfunction camPos(c) {\n  var a = c.yaw * deg, e = -c.elev * deg;\n  var y = Math.sin(e) * c.dist, z = Math.cos(e) * c.dist;\n  return [c.tgt[0] - Math.sin(a) * z, c.tgt[1] + y, c.tgt[2] + Math.cos(a) * z];\n}\n\n// One camera from keys [t, yaw, elev, dist, tx, ty, ox, oy]: each channel a monotone cubic, distance in log space so\n// push-ins feel constant-speed. probes (world points) size motion blur and check declared rests.\nfunction filmCamera(keys, probes) {\n  var CH = [1, 2, 4, 5, 6, 7].map(function (j) { return curve(keys.map(function (k) { return [k[0], k[j]]; })); });\n  var LOGD = curve(keys.map(function (k) { return [k[0], Math.log(k[3])]; }));\n  function camAt(t) { return { yaw: CH[0](t), elev: CH[1](t), dist: Math.exp(LOGD(t)), tgt: [CH[2](t), CH[3](t), 0], ox: CH[4](t), oy: CH[5](t) }; }\n  function motionOf(from, to) {\n    var a = camAt(from), b = camAt(to), far = 0;\n    probes.forEach(function (p) { var pa = project(p, a), pb = project(p, b); far = Math.max(far, Math.hypot(pb.x - pa.x, pb.y - pa.y)); });\n    return far;\n  }\n  return { camAt: camAt, motionOf: motionOf };\n}\n\n// ---- app-film kit · overlay: placing things around the app window, carrying snapshots between screens, the cursor\n// and its clicks, the accent line through 3D points, reveal wipes, underlines and masked headlines. All set from t.\n// The build defines WIN_W and WIN_H (the window size); the window is the plane z = 0, centred on the origin.\nfunction w2w(x, y, z) { return [x - WIN_W / 2, y - WIN_H / 2, z || 0]; } // window coords → world\n/** a window-space rect, lifted to z (and optionally rotated/scaled by extra) */\nfunction place(el, x, y, z, w, h, extra) {\n  el.style.width = f2(w) + \"px\"; el.style.height = f2(h) + \"px\";\n  el.style.transform = \"translate3d(\" + f2(x - WIN_W / 2) + \"px,\" + f2(y - WIN_H / 2) + \"px,\" + f2(z || 0) + \"px)\" + (extra || \"\");\n}\nfunction mk(cls, parent, html) { var e = document.createElement(\"div\"); e.className = cls; if (html != null) e.innerHTML = html; parent.appendChild(e); return e; }\nfunction arc(u) { return Math.sin(Math.PI * c01(u)); }\nfunction setHtml(el, html) { if (el.dataset.src !== html) { el.innerHTML = html; el.dataset.src = html; } }\n\n/**\n * A snapshot of a real panel ({ html, rect } from the replay) flies from where it was to `to` (a rect, or null to\n * hide), arcing toward the camera and fading as it lands. keep = 1 scales uniformly (by width); else it squashes to\n * the target's height and fades by the middle.\n */\nfunction flyClone(el, cap, to, span, t, keep) {\n  if (!cap || !to || t < span[0] || t >= span[1]) { el.style.display = \"none\"; return; }\n  setHtml(el, cap.html);\n  var u = smoother((t - span[0]) / (span[1] - span[0])), r = cap.rect;\n  var s = mix(1, to.w / r.w, u), sy = keep === 1 ? s : mix(1, to.h / r.h, u);\n  el.style.display = \"block\"; el.style.width = r.w + \"px\"; el.style.height = r.h + \"px\"; el.style.transformOrigin = \"0 0\";\n  el.style.transform = \"translate3d(\" + f2(mix(r.x, to.x, u) - WIN_W / 2) + \"px,\" + f2(mix(r.y, to.y, u) - WIN_H / 2) + \"px,\" + f2(180 * arc(u)) + \"px) scale(\" + s.toFixed(4) + \",\" + sy.toFixed(4) + \")\";\n  el.style.opacity = (1 - smr(u, keep === 1 ? 0.88 : 0.55, 1)).toFixed(3);\n}\n/** a snapshot that leaves the window and floats at a hero position { x, y, z, scale, rotY } */\nfunction heroClone(el, cap, to, u) {\n  if (!cap || u <= 0) { el.style.display = \"none\"; return; }\n  setHtml(el, cap.html);\n  var r = cap.rect;\n  el.style.display = \"block\"; el.style.width = r.w + \"px\"; el.style.height = r.h + \"px\"; el.style.transformOrigin = \"0 0\";\n  el.style.transform = \"translate3d(\" + f2(mix(r.x, to.x, u) - WIN_W / 2) + \"px,\" + f2(mix(r.y, to.y, u) - WIN_H / 2) + \"px,\" + f2(mix(0, to.z, u)) + \"px) rotateY(\" + (to.rotY * u).toFixed(2) + \"deg) scale(\" + mix(0.3, to.scale, u).toFixed(4) + \")\";\n  el.style.opacity = smr(u, 0, 0.35).toFixed(3);\n}\n\n// ---- the cursor: it travels to each action's target just before the action, arcing a little, presses on clicks,\n// and leaves a ring where it clicked. opts: { home: {x, y}, visible: [in, out] }\nfunction actionPoint(r, kind) { return kind === \"type\" || kind === \"retype\" || kind === \"focus\" ? { x: r.x + Math.min(40, r.w / 2), y: r.y + Math.min(26, r.h / 2) } : { x: r.x + r.w / 2, y: r.y + r.h / 2 }; }\nfunction poseCursor(cursor, ripple, t, rec, R, actions, opts) {\n  var prev = -1, next = -1;\n  actions.forEach(function (a, i) { if (a.t <= t) prev = i; else if (next < 0) next = i; });\n  var from = prev >= 0 ? actionPoint(rec.at[prev], actions[prev].kind) : opts.home, at = from;\n  if (next >= 0) {\n    var el = R.q(actions[next].sel);\n    if (el) {\n      var to = actionPoint(R.rect(el), actions[next].kind), a0 = Math.max(prev >= 0 ? actions[prev].t + (actions[prev].dur || 0) + 0.12 : 0, actions[next].t - 0.7);\n      var u = smoother((t - a0) / (actions[next].t - 0.06 - a0));\n      at = { x: mix(from.x, to.x, u), y: mix(from.y, to.y, u) - 30 * Math.sin(Math.PI * u) };\n    }\n  }\n  var press = 0;\n  actions.forEach(function (a) { if (a.kind === \"click\") press = Math.max(press, Math.exp(-Math.pow((t - a.t) / 0.07, 2))); });\n  cursor.style.transform = \"translate(\" + f2(at.x) + \"px,\" + f2(at.y) + \"px) scale(\" + (1 - 0.14 * press).toFixed(3) + \")\";\n  cursor.style.opacity = (smr(t, opts.visible[0], opts.visible[0] + 0.3) * (1 - smr(t, opts.visible[1], opts.visible[1] + 0.4))).toFixed(3)