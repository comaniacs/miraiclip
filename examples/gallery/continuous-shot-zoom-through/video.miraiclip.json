p\", 10.1)\n  .label(\"sent\", 10.3)\n  .iris(\"#done\", { from: \"#ship\", duration: 1.1, ease: \"inOut(3)\" }, \"sent\")\n  .hit(\"sent\", \"sent+=1.1\", { kind: \"land\" });\n});</script>",
