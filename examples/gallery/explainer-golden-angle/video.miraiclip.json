      "template": "<div class=\"stage\" data-libs=\"stage\" data-duration=\"30\" data-fps=\"30\" data-stage-version=\"2\" data-frame-timeout=\"60\" style=\"width:1920px;height:1080px;overflow:hidden\"><style>\n*{box-sizing:border-box;margin:0}\n.stage{background:radial-gradient(ellipse 70% 80% at 65% 50%,#221a10 0%,#120e09 55%,#0a0806 100%);color:#f3e9d2;font-family:'Avenir Next','Helvetica Neue',Arial,sans-serif;-webkit-font-smoothing:antialiased}\n#cv{position:absolute;left:0;top:0}\n#grain{position:absolute;inset:0;background:repeating-radial-gradient(circle at 30% 40%,rgba(255,255,255,0.012) 0 1px,transparent 1px 3px);pointer-events:none}\n.cap{position:absolute;left:110px;overflow:hidden;padding:6px 0 16px;white-space:nowrap;font-family:'Iowan Old Style','Palatino',Georgia,serif;font-style:italic;font-size:76px;line-height:1.05;color:#f3e9d2;opacity:0}\n.cap>span{display:inline-block}\n.cap b{font-style:normal;color:#f2b33d;font-weight:600}\n.cap.s{font-family:'Avenir Next','Helvetica Neue',Arial,sans-serif;font-style:normal;font-size:36px;font-weight:500;color:rgba(243,233,210,0.82);white-space:normal;width:720px;line-height:1.3}\n.cap.s b{font-weight:700}\n#dial{position:absolute;left:110px;top:590px;width:300px;height:300px;opacity:0}\n#dnum{position:absolute;left:440px;top:668px;font:600 84px 'SF Mono',Menlo,monospace;transform-origin:0 50%;letter-spacing:-0.02em;opacity:0}\n#dfrac{position:absolute;left:446px;top:778px;font:500 32px 'Avenir Next','Helvetica Neue',Arial,sans-serif;color:rgba(243,233,210,0.7);opacity:0}\n#fibrow{position:absolute;left:110px;top:900px;display:flex;gap:14px;font:600 40px 'SF Mono',Menlo,monospace;opacity:0}\n#fibrow span{padding:6px 12px;border-radius:12px;color:rgba(243,233,210,0.45)}\n#fibrow span.on{color:#120e09;background:#f2b33d}\n#cnt{position:absolute;left:110px;top:560px;font:700 220px 'SF Mono',Menlo,monospace;letter-spacing:-0.05em;line-height:1;color:#f2b33d;opacity:0}\n#cntl{position:absolute;left:120px;top:790px;font:500 34px 'Avenir Next','Helvetica Neue',Arial,sans-serif;color:rgba(243,233,210,0.8);opacity:0}\n#flash{position:absolute;inset:0;background:radial-gradient(circle at 1240px 540px,rgba(255,220,140,0.55),transparent 55%);opacity:0}\n#big{position:absolute;left:110px;top:520px;font:700 190px 'SF Mono',Menlo,monospace;letter-spacing:-0.05em;color:#f2b33d;opacity:0}\n#note{position:absolute;right:46px;bottom:28px;font:500 17px 'SF Mono',Menlo,monospace;color:rgba(243,233,210,0.45)}\n</style><canvas id=\"cv\" width=\"1920\" height=\"1080\"></canvas><div id=\"grain\"></div><div id=\"flash\"></div>\n<svg id=\"dial\" viewBox=\"0 0 380 380\"><circle cx=\"190\" cy=\"190\" r=\"176\" fill=\"rgba(18,14,9,0.6)\" stroke=\"rgba(243,233,210,0.3)\" stroke-width=\"2\"/><line x1=\"190.0\" y1=\"40.0\" x2=\"190.0\" y2=\"14.0\" stroke=\"rgba(243,233,210,0.8)\" stroke-width=\"3\"/><line x1=\"218.1\" y1=\"30.5\" x2=\"220.6\" y2=\"16.7\" stroke=\"rgba(243,233,210,0.35)\" stroke-width=\"2\"/><line x1=\"245.4\" y1=\"37.8\" x2=\"250.2\" y2=\"24.6\" stroke=\"rgba(243,233,210,0.35)\" stroke-width=\"2\"/><line x1=\"271.0\" y1=\"49.7\" x2=\"278.0\" y2=\"37.6\" stroke=\"rgba(243,233,210,0.35)\" stroke-width=\"2\"/><line x1=\"294.1\" y1=\"65.9\" x2=\"303.1\" y2=\"55.2\" stroke=\"rgba(243,233,210,0.35)\" stroke-width=\"2\"/><line x1=\"314.1\" y1=\"85.9\" x2=\"324.8\" y2=\"76.9\" stroke=\"rgba(243,233,210,0.35)\" stroke-width=\"2\"/><line x1=\"330.3\" y1=\"109.0\" x2=\"342.4\" y2=\"102.0\" stroke=\"rgba(243,233,210,0.35)\" stroke-width=\"2\"/><line x1=\"342.2\" y1=\"134.6\" x2=\"355.4\" y2=\"129.8\" stroke=\"rgba(243,233,210,0.35)\" stroke-width=\"2\"/><line x1=\"349.5\" y1=\"161.9\" x2=\"363.3\" y2=\"159.4\" stroke=\"rgba(243,233,210,0.35)\" stroke-width=\"2\"/><line x1=\"340.0\" y1=\"190.0\" x2=\"366.0\" y2=\"190.0\" stroke=\"rgba(243,233,210,0.8)\" stroke-width=\"3\"/><line x1=\"349.5\" y1=\"218.1\" x2=\"363.3\" y2=\"220.6\" stroke=\"rgba(243,233,210,0.35)\" stroke-width=\"2\"/><line x1=\"342.2\" y1=\"245.4\" x2=\"355.4\" y2=\"250.2\" stroke=\"rgba(243,233,210,0.35)\" stroke-width=\"2\"/><line x1=\"330.3\" y1=\"271.0\" x2=\"342.4\" y2=\"278.0\" stroke=\"rgba(243,233,210,0.35)\" stroke-width=\"2\"/><line x1=\"314.1\" y1=\"294.1\" x2=\"324.8\" y2=\"303.1\" stroke=\"rgba(243,233,210,0.35)\" stroke-width=\"2\"/><line x1=\"294.1\" y1=\"314.1\" x2=\"303.1\" y2=\"324.8\" stroke=\"rgba(243,233,210,0.35)\" stroke-width=\"2\"/><line x1=\"271.0\" y1=\"330.3\" x2=\"278.0\" y2=\"342.4\" stroke=\"rgba(243,233,210,0.35)\" stroke-width=\"2\"/><line x1=\"245.4\" y1=\"342.2\" x2=\"250.2\" y2=\"355.4\" stroke=\"rgba(243,233,210,0.35)\" stroke-width=\"2\"/><line x1=\"218.1\" y1=\"349.5\" x2=\"220.6\" y2=\"363.3\" stroke=\"rgba(243,233,210,0.35)\" stroke-width=\"2\"/><line x1=\"190.0\" y1=\"340.0\" x2=\"190.0\" y2=\"366.0\" stroke=\"rgba(243,233,210,0.8)\" stroke-width=\"3\"/><line x1=\"161.9\" y1=\"349.5\" x2=\"159.4\" y2=\"363.3\" stroke=\"rgba(243,233,210,0.35)\" stroke-width=\"2\"/><line x1=\"134.6\" y1=\"342.2\" x2=\"129.8\" y2=\"355.4\" stroke=\"rgba(243,233,210,0.35)\" stroke-width=\"2\"/><line x1=\"109.0\" y1=\"330.3\" x2=\"102.0\" y2=\"342.4\" stroke=\"rgba(243,233,210,0.35)\" stroke-width=\"2\"/><line x1=\"85.9\" y1=\"314.1\" x2=\"76.9\" y2=\"324.8\" stroke=\"rgba(243,233,210,0.35)\" stroke-width=\"2\"/><line x1=\"65.9\" y1=\"294.1\" x2=\"55.2\" y2=\"303.1\" stroke=\"rgba(243,233,210,0.35)\" stroke-width=\"2\"/><line x1=\"49.7\" y1=\"271.0\" x2=\"37.6\" y2=\"278.0\" stroke=\"rgba(243,233,210,0.35)\" stroke-width=\"2\"/><line x1=\"37.8\" y1=\"245.4\" x2=\"24.6\" y2=\"250.2\" stroke=\"rgba(243,233,210,0.35)\" stroke-width=\"2\"/><line x1=\"30.5\" y1=\"218.1\" x2=\"16.7\" y2=\"220.6\" stroke=\"rgba(243,233,210,0.35)\" stroke-width=\"2\"/><line x1=\"40.0\" y1=\"190.0\" x2=\"14.0\" y2=\"190.0\" stroke=\"rgba(243,233,210,0.8)\" stroke-width=\"3\"/><line x1=\"30.5\" y1=\"161.9\" x2=\"16.7\" y2=\"159.4\" stroke=\"rgba(243,233,210,0.35)\" stroke-width=\"2\"/><line x1=\"37.8\" y1=\"134.6\" x2=\"24.6\" y2=\"129.8\" stroke=\"rgba(243,233,210,0.35)\" stroke-width=\"2\"/><line x1=\"49.7\" y1=\"109.0\" x2=\"37.6\" y2=\"102.0\" stroke=\"rgba(243,233,210,0.35)\" stroke-width=\"2\"/><line x1=\"65.9\" y1=\"85.9\" x2=\"55.2\" y2=\"76.9\" stroke=\"rgba(243,233,210,0.35)\" stroke-width=\"2\"/><line x1=\"85.9\" y1=\"65.9\" x2=\"76.9\" y2=\"55.2\" stroke=\"rgba(243,233,210,0.35)\" stroke-width=\"2\"/><line x1=\"109.0\" y1=\"49.7\" x2=\"102.0\" y2=\"37.6\" stroke=\"rgba(243,233,210,0.35)\" stroke-width=\"2\"/><line x1=\"134.6\" y1=\"37.8\" x2=\"129.8\" y2=\"24.6\" stroke=\"rgba(243,233,210,0.35)\" stroke-width=\"2\"/><line x1=\"161.9\" y1=\"30.5\" x2=\"159.4\" y2=\"16.7\" stroke=\"rgba(243,233,210,0.35)\" stroke-width=\"2\"/>\n<path id=\"darc\" fill=\"none\" stroke=\"#f2b33d\" stroke-width=\"10\" stroke-linecap=\"round\"/><line x1=\"190\" y1=\"190\" x2=\"190\" y2=\"40\" stroke=\"rgba(243,233,210,0.5)\" stroke-width=\"3\"/>\n<line id=\"dneedle\" x1=\"190\" y1=\"190\" x2=\"190\" y2=\"30\" stroke=\"#f2b33d\" stroke-width=\"5\" stroke-linecap=\"round\"/><circle cx=\"190\" cy=\"190\" r=\"9\" fill=\"#f2b33d\"/></svg>\n<div id=\"dnum\">137.5°</div><div id=\"dfrac\"></div>\n<div class=\"cap \" id=\"h1\" style=\"top:150px\"><span>This flower is <b>doing math.</b></span></div><div class=\"cap s\" id=\"h2\" style=\"top:260px\"><span>Every new seed turns by the <b>same angle</b>, again and again.</span></div>\n<div class=\"cap \" id=\"r1\" style=\"top:150px\"><span>One rule.</span></div><div class=\"cap s\" id=\"r2\" style=\"top:250px\"><span>Turn by <b>θ</b>. Nudge outward. Repeat a thousand times.</span></div>\n<div class=\"cap \" id=\"a0\" style=\"top:150px\"><span>But which angle?</span></div>\n<div class=\"cap s\" id=\"a1\" style=\"top:250px\"><span><b>¼ turn</b> → 4 spokes. Wasted gaps.</span></div><div class=\"cap s\" id=\"a2\" style=\"top:250px\"><span><b>⅓ turn</b> → 3 spokes.</span></div><div class=\"cap s\" id=\"a3\" style=\"top:250px\"><span><b>⅖ turn</b> → 5 spokes.</span></div><div class=\"cap s\" id=\"a4\" style=\"top:250px\"><span>Any neat fraction eventually <b>lines up</b> into spokes. Even 137° leaves gaps.</span></div>\n<div class=\"cap \" id=\"g1\" style=\"top:150px\"><span>The <b>golden angle.</b></span></div><div class=\"cap s\" id=\"g2\" style=\"top:258px\"><span>360° × (1 − 1/φ) ≈ <b>137.5°</b></span></div><div class=\"cap s\" id=\"g3\" style=\"top:320px\"><span>φ ≈ 1.618 is the number fractions approximate <b>worst</b>, so no two seeds ever line up. Perfect packing.</span></div>\n<div class=\"cap \" id=\"f1\" style=\"top:150px\"><span>Now count the <b>spirals.</b></span></div>\n<div id=\"cnt\">0</div><div id=\"cntl\"></div>\n<div id=\"fibrow\"><span>1</span><span>1</span><span>2</span><span>3</span><span>5</span><span>8</span><span>13</span><span>21</span><span>34</span><span>55</span><span>89</span></div>\n<div class=\"cap \" id=\"p1\" style=\"top:150px\"><span>No math class.<br>Just the <b>best way</b><br><b>to pack seeds.</b></span></div><div id=\"big\">137.5°</div>\n<div id=\"note\">Model: Vogel (1979), r = c·√n, angle = n·θ</div></div>\n<script>stage.build((tl, S) => {var W = 1920, H = 1080, PERSP = 1600, WIN_W = 0, WIN_H = 0, GOLDEN = 137.50776405003788;\nvar T = {\"DUR\":30,\"FPS\":30,\"N\":1000,\"h1\":[-0.35,3],\"h2\":[1.2,3],\"rule\":[3.2,6.8],\"seeds\":[4,0.3],\"angles\":[[0,137.50776405003788],[6.8,90],[9.2,120],[11,144],[12.4,137],[14.2,137.50776405003788]],\"a1\":[7,8.5],\"a2\":[9.3,10.3],\"a3\":[11.1,11.75],\"a4\":[12.4,13.7],\"lock\":14.2,\"g1\":[14,18.8],\"g2\":[14.6,18.8],\"g3\":[15.6,18.8],\"sp34\":[19.2,21.9],\"sp55\":[22,24.7],\"f1\":[19.2,24.8],\"fib\":[19.8,24.8],\"petals\":[25,26.3],\"p1\":25.5,\"p2\":26.4,\"rest\":[28.6,30]};\n// ---- app-film kit · film-core: easing, a tiny vector kit, monotone keyframe curves and the CSS-3D projection.\n// The build defines W, H and PERSP before this file. Units are CSS pixels in world space, y down; +z is toward the\n// camera. Everything is a pure function of its inputs so frames are deterministic.\nvar $ = function (id) { return document.getElementById(id); };\nvar clamp = function (x, a, b) { return Math.max(a, Math.min(b, x)); };\nvar c01 = function (x) { return clamp(x, 0, 1); };\nvar sm = function (x) { x = c01(x); return x * x * (3 - 2 * x); };\nvar smr = function (t, a, b) { return sm((t - a) / (b - a)); };\nvar smoother = function (x) { x = c01(x); return x * x * x * (x * (x * 6 - 15) + 10); };\nvar mix = function (a, b, u) { return a + (b - a) * u; };\nvar expOut = function (x) { x = c01(x); return x >= 1 ? 1 : 1 - Math.pow(2, -10 * x); };\nvar deg = Math.PI / 180;\nvar f2 = function (x) { return x.toFixed(2); };\n\nvar V = {\n  add: function (a, b) { return [a[0] + b[0], a[1] + b[1], a[2] + b[2]]; },\n  sub: function (a, b) { return [a[0] - b[0], a[1] - b[1], a[2] - b[2]]; },\n  mul: function (a, s) { return [a[0] * s, a[1] * s, a[2] * s]; },\n  dot: function (a, b) { return a[0] * b[0] + a[1] * b[1] + a[2] * b[2]; },\n  norm: function (a) { var l = Math.hypot(a[0], a[1], a[2]) || 1; return [a[0] / l, a[1] / l, a[2] / l]; },\n};\n\n// Monotone cubic (Fritsch–Carlson) through keyframes: C1-continuous, so speed never jumps at a key, and no\n// overshoot, so the camera never swings past a framing and back.\nfunction curve(keys) {\n  var n = keys.length, xs = keys.map(function (k) { return k[0]; }), ys = keys.map(function (k) { return k[1]; });\n  var d = [], m = [];\n  for (var i = 0; i < n - 1; i++) d.push((ys[i + 1] - ys[i]) / (xs[i + 1] - xs[i]));\n  m[0] = 0; m[n - 1] = 0; // start and end at rest\n  for (i = 1; i < n - 1; i++) m[i] = d[i - 1] * d[i] <= 0 ? 0 : (d[i - 1] + d[i]) / 2;\n  for (i = 0; i < n - 1; i++) {\n    if (d[i] === 0) { m[i] = m[i + 1] = 0; continue; }\n    var a = m[i] / d[i], b = m[i + 1] / d[i], s = a * a + b * b;\n    if (s > 9) { var tau = 3 / Math.sqrt(s); m[i] = tau * a * d[i]; m[i + 1] = tau * b * d[i]; }\n  }\n  return function (x) {\n    if (x <= xs[0]) return ys[0];\n    if (x >= xs[n - 1]) return ys[n - 1];\n    var k = 0; while (x > xs[k + 1]) k++;\n    var h = xs[k + 1] - xs[k], u = (x - xs[k]) / h, u2 = u * u, u3 = u2 * u;\n    return (2 * u3 - 3 * u2 + 1) * ys[k] + (u3 - 2 * u2 + u) * h * m[k] + (-2 * u3 + 3 * u2) * ys[k + 1] + (u3 - u2) * h * m[k + 1];\n  };\n}\n\n// The camera is a pose { yaw, elev, dist, tgt, ox, oy } (degrees, px). The world element gets\n//   translateZ(PERSP - dist) rotateX(-elev) rotateY(yaw) translate3d(-tgt)\n// inside a perspective of PERSP, and the whole view is shifted by (ox, oy) on screen. project() is the same maths,\n// so overlay lines and the shot check land exactly on what CSS draws. dist = PERSP at yaw = elev = 0 shows the\n// plane z = 0 at exactly 1:1 pixels.\nfunction camTransform(c) {\n  return \"translateZ(\" + f2(PERSP - c.dist) + \"px) rotateX(\" + (-c.elev).toFixed(3) + \"deg) rotateY(\" + c.yaw.toFixed(3) + \"deg) translate3d(\" + f2(-c.tgt[0]) + \"px,\" + f2(-c.tgt[1]) + \"px,\" + f2(-c.tgt[2]) + \"px)\";\n}\nfunction toView(p, c) {\n  var q = V.sub(p, c.tgt), a = c.yaw * deg, e = -c.elev * deg;\n  var x1 = Math.cos(a) * q[0] + Math.sin(a) * q[2], z1 = -Math.sin(a) * q[0] + Math.cos(a) * q[2], y1 = q[1]; // rotateY\n  var y2 = Math.cos(e) * y1 - Math.sin(e) * z1, z2 = Math.sin(e) * y1 + Math.cos(e) * z1; // rotateX\n  return [x1, y2, z2 + PERSP - c.dist];\n}\nfunction project(p, c) {\n  var v = toView(p, c), k = PERSP / (PERSP - v[2]);\n  return { x: W / 2 + c.ox + v[0] * k, y: H / 2 + c.oy + v[1] * k, k: k, behind: v[2] >= PERSP - 1 };\n}\n// where the camera is in the world: the inverse of the two rotations applied to (0, 0, dist)\nfunction camPos(c) {\n  var a = c.yaw * deg, e = -c.elev * deg;\n  var y = Math.sin(e) * c.dist, z = Math.cos(e) * c.dist;\n  return [c.tgt[0] - Math.sin(a) * z, c.tgt[1] + y, c.tgt[2] + Math.cos(a) * z];\n}\n\n// One camera from keys [t, yaw, elev, dist, tx, ty, ox, oy]: each channel a monotone cubic, distance in log space so\n// push-ins feel constant-speed. probes (world points) size motion blur and check declared rests.\nfunction filmCamera(keys, probes) {\n  var CH = [1, 2, 4, 5, 6, 7].map(function (j) { return curve(keys.map(function (k) { return [k[0], k[j]]; })); });\n  var LOGD = curve(keys.map(function (k) { return [k[0], Math.log(k[3])]; }));\n  function camAt(t) { return { yaw: CH[0](t), elev: CH[1](t), dist: Math.exp(LOGD(t)), tgt: [CH[2](t), CH[3](t), 0], ox: CH[4](t), oy: CH[5](t) }; }\n  function motionOf(from, to) {\n    var a = camAt(from), b = camAt(to), far = 0;\n    probes.forEach(function (p) { var pa = project(p, a), pb = project(p, b); far = Math.max(far, Math.hypot(pb.x - pa.x, pb.y - pa.y)); });\n    return far;\n  }\n  return { camAt: camAt, motionOf: motionOf };\n}\n\n// ---- app-film kit · overlay: placing things around the app window, carrying snapshots between screens, the cursor\n// and its clicks, the accent line through 3D points, reveal wipes, underlines and masked headlines. All set from t.\n// The build defines WIN_W and WIN_H (the window size); the window is the plane z = 0, centred on the origin.\nfunction w2w(x, y, z) { return [x - WIN_W / 2, y - WIN_H / 2, z || 0]; } // window coords → world\n/** a window-space rect, lifted to z (and optionally rotated/scaled by extra) */\nfunction place(el, x, y, z, w, h, extra) {\n  el.style.width = f2(w) + \"px\"; el.style.height = f2(h) + \"px\";\n  el.style.transform = \"translate3d(\" + f2(x - WIN_W / 2) + \"px,\" + f2(y - WIN_H / 2) + \"px,\" + f2(z || 0) + \"px)\" + (extra || \"\");\n}\nfunction mk(cls, parent, html) { var e = document.createElement(\"div\"); e.className = cls; if (html != null) e.innerHTML = html; parent.appendChild(e); return e; }\nfunction arc(u) { return Math.sin(Math.PI * c01(u)); }\nfunction setHtml(el, html) { if (el.dataset.src !== html) { el.innerHTML = html; el.dataset.src = html; } }\n\n/**\n * A snapshot of a real panel ({ html, rect } from the replay) flies from where it was to `to` (a rect, or null to\n * hide), arcing toward the camera and fading as it lands. keep = 1 scales uniformly (by width); else it squashes to\n * the target's height and fades by the middle.\n */\nfunction flyClone(el, cap, to, span, t, keep) {\n  if (!cap || !to || t < span[0] || t >= span[1]) { el.style.display = \"none\"; return; }\n  setHtml(el, cap.html);\n  var u = smoother((t - span[0]) / (span[1] - span[0])), r = cap.rect;\n  var s = mix(1, to.w / r.w, u), sy = keep === 1 ? s : mix(1, to.h / r.h, u);\n  el.style.display = \"block\"; el.style.width = r.w + \"px\"; el.style.height = r.h + \"px\"; el.style.transformOrigin = \"0 0\";\n  el.style.transform = \"translate3d(\" + f2(mix(r.x, to.x, u) - WIN_W / 2) + \"px,\" + f2(mix(r.y, to.y, u) - WIN_H / 2) + \"px,\" + f2(180 * arc(u)) + \"px) scale(\" + s.toFixed(4) + \",\" + sy.toFixed(4) + \")\";\n  el.style.opacity = (1 - smr(u, keep === 1 ? 0.88 : 0.55, 1)).toFixed(3);\n}\n/** a snapshot that leaves the window and floats at a hero position { x, y, z, scale, rotY } */\nfunction heroClone(el, cap, to, u) {\n  if (!cap || u <= 0) { el.style.display = \"none\"; return; }\n  setHtml(el, cap.html);\n  var r = cap.rect;\n  el.style.display = \"block\"; el.style.width = r.w + \"px\"; el.style.height = r.h + \"px\"; el.style.transformOrigin = \"0 0\";\n  el.style.transform = \"translate3d(\" + f2(mix(r.x, to.x, u) - WIN_W / 2) + \"px,\" + f2(mix(r.y, to.y, u) - WIN_H / 2) + \"px,\" + f2(mix(0, to.z, u)) + \"px) rotateY(\" + (to.rotY * u).toFixed(2) + \"deg) scale(\" + mix(0.3, to.scale, u).toFixed(4) + \")\";\n  el.style.opacity = smr(u, 0, 0.35).toFixed(3);\n}\n\n// ---- the cursor: it travels to each action's target just before the action, arcing a little, presses on clicks,\n// and leaves a ring where it clicked. opts: { home: {x, y}, visible: [in, out] }\nfunction actionPoint(r, kind) { return kind === \"type\" || kind === \"retype\" || kind === \"focus\" ? { x: r.x + Math.min(40, r.w / 2), y: r.y + Math.min(26, r.h / 2) } : { x: r.x + r.w / 2, y: r.y + r.h / 2 }; }\nfunction poseCursor(cursor, ripple, t, rec, R, actions, opts) {\n  var prev = -1, next = -1;\n  actions.forEach(function (a, i) { if (a.t <= t) prev = i; else if (next < 0) next = i; });\n  var from = prev >= 0 ? actionPoint(rec.at[prev], actions[prev].kind) : opts.home, at = from;\n  if (next >= 0) {\n    var el = R.q(actions[next].sel);\n    if (el) {\n      var to = actionPoint(R.rect(el), actions[next].kind), a0 = Math.max(prev >= 0 ? actions[prev].t + (actions[prev].dur || 0) + 0.12 : 0, actions[next].t - 0.7);\n      var u = smoother((t - a0) / (actions[next].t - 0.06 - a0));\n      at = { x: mix(from.x, to.x, u), y: mix(from.y, to.y, u) - 30 * Math.sin(Math.PI * u) };\n    }\n  }\n  var press = 0;\n  actions.forEach(function (a) { if (a.kind === \"click\") press = Math.max(press, Math.exp(-Math.pow((t - a.t) / 0.07, 2))); });\n  cursor.style.transform = \"translate(\" + f2(at.x) + \"px,\" + f2(at.y) + \"px) scale(\" + (1 - 0.14 * press).toFixed(3) + \")\";\n  cursor.style.opacity = (smr(t, opts.visible[0], opts.visible[0] + 0.3) * (1 - smr(t, opts.visible[1], opts.visible[1] + 0.4))).toFixed(3);\n  var c = -1;\n  actions.forEach(function (a, i) { if (a.kind === \"click\" && a.t <= t && t - a.t < 0.5) c = i; });\n  if (c >= 0) {\n    var p = actionPoint(rec.at[c], \"click\"), k = (t - actions[c].t) / 0.5;\n    ripple.style.display = \"block\";\n    ripple.style.transform = \"translate(\" + f2(p.x) + \"px,\" + f2(p.y) + \"px) scale(\" + (0.3 + 1.4 * expOut(k)).toFixed(3) + \")\";\n    ripple.style.opacity = (0.9 * (1 - k)).toFixed(3);\n  } else ripple.style.display = \"none\";\n}\n\n/** a wipe over a real element's rect, top to bottom, with a glowing edge (the app shows it all at once) */\nfunction revealMask(mask, r, u) {\n  if (!r || u <= 0 || u >= 1) { mask.style.display = \"none\"; return; }\n  var top = r.y + 2 + (r.h - 4) * u;\n  mask.style.display = \"block\";\n  mask.style.left = r.x + 2 + \"px\"; mask.style.width = r.w - 4 + \"px\"; mask.style.top = f2(top) + \"px\"; mask.style.height = f2(r.y + r.h - 2 - top) + \"px\";\n}\n/** an accent bar under a real element's rect */\nfunction underline(bar, r, on) {\n  if (!r || on <= 0) { bar.style.display = \"none\"; return; }\n  bar.style.display = \"block\"; bar.style.left = r.x + \"px\"; bar.style.top = r.y + r.h + 1 + \"px\"; bar.style.width = Math.max(8, r.w) + \"px\";\n  bar.style.opacity = on.toFixed(3);\n}\n\n// ---- the accent line: one stroke through 3D points, projected, smoothed (Catmull-Rom → Bézier), drawn up to a share\nfunction drawLine(path, worldPts, c, share, alpha) {\n  if (worldPts.length < 2 || share <= 0 || alpha <= 0) { path.style.opacity = 0; return; }\n  var P = worldPts.map(function (p) { return project(p, c); }), d = \"M\" + f2(P[0].x) + \" \" + f2(P[0].y);\n  for (var i = 0; i < P.length - 1; i++) {\n    var p0 = P[Math.max(0, i - 1)], p1 = P[i], p2 = P[i + 1], p3 = P[Math.min(P.length - 1, i + 2)];\n    d += \" C\" + f2(p1.x + (p2.x - p0.x) / 6) + \" \" + f2(p1.y + (p2.y - p0.y) / 6) + \" \" + f2(p2.x - (p3.x - p1.x) / 6) + \" \" + f2(p2.y - (p3.y - p1.y) / 6) + \" \" + f2(p2.x) + \" \" + f2(p2.y);\n  }\n  path.setAttribute(\"d\", d);\n  var len = path.getTotalLength();\n  path.style.strokeDasharray = f2(len) + \" \" + f2(len + 10);\n  path.style.strokeDashoffset = f2(len * (1 - c01(share)));\n  path.style.opacity = c01(alpha).toFixed(3);\n}\n\n// ---- headlines: one visual language for every line. A line rises through its mask and drifts up as it leaves.\nfunction lineIO(id, span, t) {\n  var e = $(id), sp = e.firstElementChild, u = smoother((t - span[0]) / 0.6), v = sm((t - span[1]) / 0.45);\n  e.style.opacity = t < span[0] || t > span[1] + 0.45 ? 0 : 1;\n  sp.style.transform = \"translateY(\" + ((1 - u) * 108 - v * 22).toFixed(2) + \"%)\";\n  sp.style.opacity = (u * (1 - v)).toFixed(3);\n}\nfunction fadeIO(id, tin, tout, t, dy) {\n  var e = $(id), u = smoother((t - tin) / 0.55), v = sm((t - tout) / 0.45);\n  e.style.opacity = (u * (1 - v)).toFixed(3);\n  e.style.transform = \"translateY(\" + ((1 - u) * (dy || 16) - v * 10).toFixed(2) + \"px)\";\n}\n/** how much a scrim behind headlines should show: the max over the spans that sit over the UI */\nfunction scrimAt(t, spans) {\n  return spans.reduce(function (m, s) { return Math.max(m, smr(t, s[0] - 0.2, s[0] + 0.3) * (1 - smr(t, s[1], s[1] + 0.5))); }, 0);\n}\n\n// ==== film/10-flower.js\n// ---- the flower: N seeds by Vogel's model, r = c·√n and angle = n·θ, drawn on a canvas every frame. θ sweeps\n// through simple fractions of a turn (spokes) to the golden angle (perfect packing); then the hidden Fibonacci\n// spiral families light up arm by arm, and petals grow round the rim.\nvar cv = $(\"cv\"), ctx = cv.getContext(\"2d\"), N = T.N, C = 14.2, CX = 1240, CY = 540;\nfunction show(id, on) { $(id).style.display = on ? \"block\" : \"none\"; }\nfunction hexmix(a, b, u) { return [0, 1, 2].map(function (k) { return Math.round(a[k] + (b[k] - a[k]) * u); }); }\nvar BASE = []; for (var i = 0; i < N; i++) { var j = 0.85 + 0.3 * ((i * 7919) % 97) / 97; BASE.push(hexmix([70, 40, 16], [242, 179, 61], Math.pow(i / N, 0.8)).map(function (v) { return Math.min(255, Math.round(v * j)); })); }\n\nfunction thetaAt(t) {\n  var A = T.angles, th = A[0][1];\n  for (var k = 1; k < A.length; k++) { var d = k === 1 ? 0.8 : k === A.length - 1 ? 1.3 : 0.6; th = mix(th, A[k][1], smoother((t - (A[k][0] - d)) / d)); }\n  return th;\n}\nvar ZOOM = curve([[0, 1], [3.2, 1], [4.0, 4.2], [6.0, 4.2], [6.8, 1], [25.0, 1], [26.3, 0.8], [30, 0.8]]);\nvar MOVE = curve([[0, 0], [25.0, 0], [26.3, 70], [30, 70]]);\nfunction grow(i, t) { var a = -0.45 + 1.7 * Math.pow(i / N, 0.7); // the burst is already under way on frame 0\n  return expOut((t - a) / 0.35); }\nfunction rot(t) { return Math.min(t, T.rest[0]) * 3; } // a slow turn, frozen for the final rest\nfunction seedXY(i, t, th) {\n  var z = ZOOM(t), r = C * Math.sqrt(i + 0.5) * grow(i, t) * z, a = (i * th + rot(t)) * deg;\n  return [CX + MOVE(t) + r * Math.cos(a), CY + r * Math.sin(a)];\n}\nfunction seedMotion(from, to) {\n  return [5, 200, 600, 999].reduce(function (m, i) { var a = seedXY(i, from, thetaAt(from)), b = seedXY(i, to, thetaAt(to)); return Math.max(m, Math.hypot(b[0] - a[0], b[1] - a[1])); }, 0);\n}\n// the spiral families: arm = n mod F; arms light up one by one as they're counted\nfunction family(t, sp, F) { var on = smr(t, sp[0], sp[0] + 0.4) * (1 - smr(t, sp[1] - 0.3, sp[1])), n = Math.floor(F * smr(t, sp[0] + 0.2, sp[0] + 1.9) + 1e-6); return { on: on, n: n, F: F }; }\n\nfunction drawPetals(t, z) {\n  var u0 = T.petals[0]; if (t < u0) return;\n  var R = C * Math.sqrt(N) * z, rt = rot(t) * deg;\n  for (var ring = 0; ring < 2; ring++) for (var k = 0; k < 34; k++) {\n    var g = expOut((t - u0 - 0.025 * k - 0.15 * ring) / 0.6); if (g <= 0) continue;\n    var a = (k + ring * 0.5) / 34 * Math.PI * 2 + rt, len = (ring ? 125 : 150) * g, wid = 26 * g;\n    ctx.save(); ctx.translate(CX + MOVE(t) + Math.cos(a) * (R - 10), CY + Math.sin(a) * (R - 10)); ctx.rotate(a);\n    ctx.beginPath(); ctx.ellipse(len / 2, 0, len / 2, wid / 2, 0, 0, Math.PI * 2);\n    ctx.fillStyle = ring ? \"#d99a1e\" : \"#f5c242\"; ctx.fill(); ctx.strokeStyle = \"rgba(90,50,10,0.5)\"; ctx.lineWidth = 2; ctx.stroke(); ctx.restore();\n  }\n}\nfunction paintFlower(t) {\n  ctx.clearRect(0, 0, W, H);\n  var th = thetaAt(t), z = ZOOM(t), f34 = family(t, T.sp34, 34), f55 = family(t, T.sp55, 55);\n  var dim = smr(t, 3.5, 4.0) * (1 - smr(t, 6.0, 6.6)); // the rule close-up dims all but the first seeds\n  drawPetals(t, z);\n  for (var i = 0; i < N; i++) {\n    var g = grow(i, t); if (g <= 0.001) continue;\n    var p = seedXY(i, t, th), rgb = BASE[i], s = C * 0.5 * z * (0.85 + 0.3 * i / N) * Math.min(1, g * 1.3);\n    [f34, f55].forEach(function (f) {\n      if (f.on <= 0) return;\n      var arm = i % f.F, lit = arm < f.n ? (arm % 2 ? [255, 228, 160] : [255, 150, 60]) : [40, 28, 14];\n      rgb = hexmix(rgb, lit, f.on * (arm < f.n ? 0.95 : 0.7));\n    });\n    var a = i < 7 ? 1 : 1 - 0.85 * dim;\n    ctx.fillStyle = \"rgba(\" + rgb[0] + \",\" + rgb[1] + \",\" + rgb[2] + \",\" + a.toFixed(3) + \")\";\n    ctx.beginPath(); ctx.arc(p[0], p[1], s, 0, Math.PI * 2); ctx.fill();\n  }\n  if (dim > 0.01) drawRule(t, th, z, dim);\n}\n// the close-up: the first seeds numbered, with the turn between each and the next drawn as an arc\nfunction drawRule(t, th, z, dim) {\n  ctx.save(); ctx.globalAlpha = dim; ctx.font = \"600 22px 'SF Mono',Menlo,monospace\"; ctx.textAlign = \"center\"; ctx.textBaseline = \"middle\";\n  for (var k = 1; k < 7; k++) {\n    var u = c01((t - T.seeds[0] - T.seeds[1] * k) / 0.25); if (u <= 0) continue;\n    var a0 = ((k - 1) * th + rot(t)) * deg, a1 = a0 + th * deg * u, rr = C * Math.sqrt(k + 0.5) * z;\n    ctx.strokeStyle = \"rgba(243,233,210,0.75)\"; ctx.lineWidth = 3; ctx.beginPath(); ctx.arc(CX, CY, rr * 0.55 + 18, a0, a1); ctx.stroke();\n    var p = seedXY(k, t, th);\n    ctx.fillStyle = \"#f3e9d2\"; ctx.fillText(String(k), p[0] + 26 * Math.cos(a1), p[1] + 26 * Math.sin(a1));\n  }\n  ctx.restore();\n}\n\n// ==== film/20-type.js\n// ---- the type, the dial, the counters and the Fibonacci row.\nfunction capIO(id, span, t) { lineIO(id, span, t); }\nfunction fracLabel(th) {\n  var L = [[90, \"¼ turn\"], [120, \"⅓ turn\"], [144, \"⅖ turn\"], [137.0, \"so close…\"], [GOLDEN, \"the golden angle\"]];\n  for (var k = 0; k < L.length; k++) if (Math.abs(th - L[k][0]) < 0.06) return L[k][1];\n  return \"\";\n}\nfunction poseDial(t, th) {\n  [\"dial\", \"dnum\", \"dfrac\"].forEach(function (id) { fadeIO(id, 3.6, 18.6, t, 20); });\n  $(\"dneedle\").setAttribute(\"transform\", \"rotate(\" + th.toFixed(3) + \" 190 190)\");\n  var a = (th - 90) * deg, x = 190 + 150 * Math.cos(a), y = 190 + 150 * Math.sin(a);\n  $(\"darc\").setAttribute(\"d\", \"M190 40 A150 150 0 \" + (th > 180 ? 1 : 0) + \" 1 \" + x.toFixed(2) + \" \" + y.toFixed(2));\n  setHtml($(\"dnum\"), th.toFixed(1) + \"°\");\n  setHtml($(\"dfrac\"), fracLabel(th));\n  var lock = t > T.lock ? Math.exp(-(t - T.lock) * 5) : 0;\n  $(\"dnum\").style.color = t > T.lock - 0.1 ? \"#f2b33d\" : \"#f3e9d2\";\n  $(\"dnum\").style.transform += \" scale(\" + (1 + 0.15 * lock).toFixed(3) + \")\";\n}\nfunction poseType(t) {\n  var th = thetaAt(t);\n  capIO(\"h1\", T.h1, t); capIO(\"h2\", T.h2, t);\n  capIO(\"r1\", [T.rule[0] + 0.2, T.rule[1] - 0.6], t); capIO(\"r2\", [T.rule[0] + 0.5, T.rule[1] - 0.6], t);\n  capIO(\"a0\", [T.angles[1][0] - 0.4, T.angles[5][0] - 0.3], t);\n  capIO(\"a1\", T.a1, t); capIO(\"a2\", T.a2, t); capIO(\"a3\", T.a3, t); capIO(\"a4\", T.a4, t);\n  capIO(\"g1\", T.g1, t); capIO(\"g2\", T.g2, t); capIO(\"g3\", T.g3, t);\n  poseDial(t, th);\n  $(\"flash\").style.opacity = (t > T.lock ? 0.9 * Math.exp(-(t - T.lock) * 3.5) : 0).toFixed(3);\n  // the spirals: a big counter that ticks with the arms, and the Fibonacci row with the two counts lit\n  capIO(\"f1\", T.f1, t);\n  var f34 = family(t, T.sp34, 34), f55 = family(t, T.sp55, 55), cur = t < T.sp55[0] ? f34 : f55;\n  fadeIO(\"cnt\", T.sp34[0], T.f1[1] - 0.3, t, 30); fadeIO(\"cntl\", T.sp34[0] + 0.3, T.f1[1] - 0.3, t, 16);\n  setHtml($(\"cnt\"), String(cur.n));\n  var tick = 1 + 0.06 * Math.abs(Math.sin(cur.n * 1.7)) * (cur.n < cur.F ? 1 : 0);\n  $(\"cnt\").style.transform += \" scale(\" + tick.toFixed(3) + \")\"; $(\"cnt\").style.transformOrigin = \"0 50%\";\n  setHtml($(\"cntl\"), t < T.sp55[0] ? \"spirals one way\" : \"spirals the other way\");\n  fadeIO(\"fibrow\", T.fib[0], T.fib[1], t, 20);\n  [].forEach.call($(\"fibrow\").children, function (s, k) { s.className = (k === 8 && t > T.sp34[0] + 1.9) || (k === 9 && t > T.sp55[0] + 1.9) ? \"on\" : \"\"; });\n  // the payoff\n  lineIO(\"p1\", [T.p1, 99], t);\n  fadeIO(\"big\", T.p2, 99, t, 30);\n}\n\n// ==== film/60-main.js\n// ---- the frame: the canvas painter reports its own motion (from probe seeds); the DOM painter holds.\ntl.frame(paintFlower, { motion: seedMotion });\ntl.frame(poseType, { hold: true });\ntl.subject(\"the flower\", function (t) { return { x: CX + MOVE(t), y: CY, r: 450 * ZOOM(t) }; }, { minPx: 30 });\ntl.rest(T.rest[0], T.rest[1]);\ntl.label(\"hook\", 0).label(\"rule\", T.rule[0]).label(\"seeds\", T.seeds[0]).label(\"quarter\", T.angles[1][0]).label(\"third\", T.angles[2][0]).label(\"fifths\", T.angles[3][0])\n  .label(\"close\", T.angles[4][0]).label(\"golden\", T.lock).label(\"why\", T.g3[0]).label(\"spirals34\", T.sp34[0]).label(\"spirals55\", T.sp55[0]).label(\"petals\", T.petals[0]).label(\"payoff\", T.p2);\ntl.hit(\"lock\", T.lock, { kind: \"impact\" }).hit(\"payoff\", T.p2, { kind: \"land\" });\n});</script>",
