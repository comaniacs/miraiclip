{
  "name": "cursor-click",
  "title": "Cursor — click ripple",
  "description": "An expanding ring that marks a click. Drop one at each click position for half a second.",
  "category": "cursor",
  "tags": [
    "click",
    "ripple",
    "screen",
    "tutorial"
  ],
  "version": "1.0.0",
  "aspects": [
    "any"
  ],
  "fields": [
    {
      "key": "color",
      "label": "Colour",
      "type": "color",
      "default": "#38bdf8"
    }
  ],
  "content": {
    "kind": "html",
    "template": "<div style=\"width:160px;height:160px;display:flex;align-items:center;justify-content:center\"><style>@keyframes ripple{0%{transform:scale(.2);opacity:.9}100%{transform:scale(1);opacity:0}}@keyframes dot{0%{transform:scale(1);opacity:.9}100%{transform:scale(.6);opacity:0}}</style>\n<div style=\"position:absolute;width:140px;height:140px;border-radius:50%;border:6px solid {{color}};animation:ripple var(--T) cubic-bezier(.2,.8,.2,1) both\"></div>\n<div style=\"width:30px;height:30px;border-radius:50%;background:{{color}};animation:dot var(--T) ease-out both\"></div></div>",
    "widthPx": 160,
    "heightPx": 160,
    "animated": true,
    "durationUs": 600000,
    "transform": {
      "x": 0.5,
      "y": 0.5
    }
  }
}
